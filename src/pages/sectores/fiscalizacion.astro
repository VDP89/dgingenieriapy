---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const capacidades = [
  { title: 'Anteproyecto y proyecto', desc: 'Desarrollo del anteproyecto y el proyecto ejecutivo: arquitectura, estructuras e instalaciones coordinadas, listo para licitar y construir.', icon: 'docs' },
  { title: 'Gerenciamiento de obra', desc: 'Conducción del proyecto de punta a punta: cronograma, presupuesto por rubro, contratistas y decisiones técnicas, sobre una baseline auditable.', icon: 'chart' },
  { title: 'Construcción y dirección de obra', desc: 'Dirección de la construcción con coordinación de contratistas y control de calidad en sitio, sin que el inversor tenga que armar estructura de obra propia.', icon: 'build' },
  { title: 'Fiscalización y valor ganado', desc: 'Control técnico independiente con Curva S, valor ganado (SPI y CPI) y detección temprana de desvíos de plazo y costo.', icon: 'eye' },
  { title: 'Coordinación de especialidades', desc: 'Articulación entre arquitectura, estructuras, sanitarias y eléctricas para evitar ruido técnico y retrabajos en obra.', icon: 'network' },
  { title: 'Visibilidad para el inversor', desc: 'Plataforma ERGON: avance físico y financiero en tiempo real, reportes diferenciados por stakeholder y alertas tempranas con respaldo técnico.', icon: 'alert' },
];

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Sectores', url: '/sectores' },
  { name: 'Edificación Residencial', url: '/sectores/fiscalizacion' },
];

// JSON-LD: Service — ala técnica del desarrollo residencial (ciclo completo)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Edificación residencial: del proyecto a la fiscalización',
  serviceType: 'Desarrollo y dirección técnica de obra residencial',
  description: 'Ala técnica del desarrollo residencial en Paraguay: anteproyecto y proyecto ejecutivo, gerenciamiento de obra, dirección de la construcción y fiscalización con valor ganado, sobre la plataforma propia ERGON. Para edificaciones residenciales de mediano y gran porte: casas, dúplex y edificios.',
  provider: {
    '@type': 'Organization',
    name: 'DG Ingeniería SRL',
    url: 'https://dgingenieriapy.com',
  },
  areaServed: { '@type': 'Country', name: 'Paraguay' },
  url: 'https://dgingenieriapy.com/sectores/fiscalizacion',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Capacidades de edificación y dirección técnica residencial',
    itemListElement: capacidades.map((c) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: c.title,
        description: c.desc,
      },
    })),
  },
};

// JSON-LD: FAQ — citación para "ala técnica de un desarrollo residencial" + fiscalización/EVM
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Qué hace el ala técnica de un desarrollo residencial?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El ala técnica resuelve toda la ejecución de un desarrollo residencial para quien aporta la tierra y el capital. DG Ingeniería actúa como ese brazo técnico: desarrolla el anteproyecto y el proyecto ejecutivo, gerencia la obra, dirige la construcción coordinando a los contratistas y la fiscaliza con valor ganado, todo sobre la plataforma propia ERGON. El desarrollador o inversor pone el terreno, el capital y la visión comercial; DG es el único responsable técnico de la ejecución, del primer plano a la entrega de unidades, sin que el inversor tenga que montar una estructura de obra propia.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué incluye desarrollar un edificio o un dúplex residencial, del anteproyecto a la entrega?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El ciclo completo de una edificación residencial incluye: anteproyecto y proyecto ejecutivo (arquitectura, estructuras e instalaciones coordinadas); factibilidad técnica del sitio; gerenciamiento de obra (cronograma, presupuesto por rubro, contratistas) sobre una baseline auditable; dirección de la construcción con control de calidad en sitio; coordinación de especialidades; y fiscalización con Curva S y valor ganado. DG cubre estas etapas para edificaciones de mediano y gran porte —casas, dúplex y edificios— con visibilidad técnica en tiempo real para el inversor a través de la plataforma ERGON.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cómo se mide el avance de obra con valor ganado (EVM)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El análisis de valor ganado compara tres valores: el Planned Value (lo planificado al corte), el Earned Value (lo ejecutado valorizado a baseline) y el Actual Cost (lo realmente gastado). De ahí se derivan dos indicadores clave: SPI (Schedule Performance Index = EV/PV) que mide cumplimiento de plazo, y CPI (Cost Performance Index = EV/AC) que mide eficiencia de costo. SPI o CPI menor a 1 indica desvío. La detección temprana permite acción correctiva antes de que el desvío se vuelva irreversible.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué información recibe el inversor durante la obra?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'El inversor recibe un resumen ejecutivo enfocado en decisiones: dónde está la obra hoy, qué pasó en el período que cambia el horizonte del proyecto, y dónde hay que tomar una decisión en los próximos quince días. Indicadores clave (SPI, CPI, avance físico, avance financiero), alertas activas y eventos contractuales relevantes. El nivel de detalle es distinto al dashboard operativo que recibe el director de proyecto y a las planillas operativas que usa el profesional de campo en el sitio.',
      },
    },
  ],
};
---

<Base
  title="Edificación residencial: del proyecto a la fiscalización"
  description="Ala técnica del desarrollo residencial en Paraguay: anteproyecto, proyecto, gerenciamiento, construcción y fiscalización de edificaciones de mediano y gran porte (casas, dúplex, edificios) con la plataforma ERGON."
  preloadImg="/img/sector-civil.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageHero
    img="/img/sector-civil.jpg"
    imgAlt="Edificación residencial y dirección técnica de obra"
    kicker="Sectores · Desarrollo residencial"
    title="El ala técnica"
    titleAccent="del desarrollo residencial"
    subtitle="Del anteproyecto a la entrega: proyecto, gerenciamiento, construcción y fiscalización de edificaciones residenciales de mediano y gran porte, sobre la plataforma ERGON."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Consultar desarrollo</Button>
    <Button href="/sectores" variant="ghost-dark">Todos los sectores</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Enfoque"
          title="Un único responsable técnico"
          titleAccent="de la ejecución"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>Un desarrollo residencial se gana o se pierde en la ejecución técnica. Quien tiene la tierra y el capital necesita una pata técnica que lleve el proyecto del anteproyecto a la entrega, sin tener que montar una estructura de obra propia.</p>
        <p>Ahí entra DG, como el ala técnica del desarrollo. Hacemos el anteproyecto y el proyecto ejecutivo, gerenciamos la obra, dirigimos la construcción coordinando a los contratistas y la fiscalizamos con valor ganado. Un solo responsable técnico de la ejecución, del primer plano a la entrega de unidades.</p>
        <p>Trabajamos sobre edificaciones residenciales de mediano y gran porte: casas, dúplex y edificios. El desarrollador o inversor pone la tierra, el capital y la visión comercial; nosotros resolvemos toda la ingeniería y la conducción de obra, con visibilidad técnica en tiempo real a través de la plataforma propia ERGON.</p>
        <p>Sobre cómo la visibilidad técnica cambia decisiones de obra, leer el caso real <a href="/blog/fiscalizacion-con-visibilidad" class="text-arena font-semibold underline decoration-arena/30 hover:decoration-arena underline-offset-4 transition-colors">Fiscalización con visibilidad real de obra</a> — auditoría altimétrica que evitó un relleno innecesario en una obra sobre el río.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capacidades"
      title="Lo que hacemos"
      lead="El ciclo completo de la edificación residencial: del anteproyecto al control de obra, con visibilidad en tiempo real sobre la plataforma ERGON."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capacidades.map((c) => (
        <div class="bg-white rounded-xl p-7 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-11 h-11 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            {c.icon === 'docs' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>}
            {c.icon === 'chart' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l4-4 4 4 5-5"/></svg>}
            {c.icon === 'build' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-3M9 9v.01M9 13v.01M9 17v.01"/></svg>}
            {c.icon === 'eye' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 12s3-8 10-8 10 8 10 8-3 8-10 8-10-8-10-8Z"/><circle cx="12" cy="12" r="3"/></svg>}
            {c.icon === 'network' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 7l3 3m7-3-3 3m-7 7 3-3m7 3-3-3"/></svg>}
            {c.icon === 'alert' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0ZM12 9v4m0 4h.01"/></svg>}
          </div>
          <h3 class="text-[17px] font-extrabold tracking-tight mb-2 text-slate-dg">{c.title}</h3>
          <p class="text-[13.5px] text-slate-dg/65 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Para desarrolladores e inversores"
          title="Su pata técnica,"
          titleAccent="sin estructura de obra propia"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>Un desarrollo residencial se ejecuta con conducción técnica de punta a punta. DG cubre esa capa para quien tiene la tierra y el capital pero no quiere montar un equipo de obra:</p>
        <ul class="space-y-3 list-none pl-0">
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Anteproyecto y proyecto:</strong> diseño ejecutivo de arquitectura, estructuras e instalaciones, listo para construir.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Gerenciamiento y dirección de obra:</strong> un único responsable técnico de la ejecución, con la construcción coordinada y controlada.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Fiscalización y valor ganado:</strong> control técnico independiente con Curva S, SPI y CPI.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Visibilidad ERGON:</strong> avance físico y financiero en tiempo real, del lado del inversor.</span></li>
        </ul>
        <p>El desarrollador pone la tierra, el capital y la visión comercial; DG resuelve la ejecución técnica completa, del anteproyecto a la entrega de unidades.</p>
      </div>
    </div>
  </FullBleedSection>

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">¿Desarrolla un proyecto residencial?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Busque un ala técnica para el anteproyecto, el proyecto, el gerenciamiento, la construcción o la fiscalización. Hablemos sobre la ejecución técnica de su desarrollo.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/sectores" variant="ghost-dark" size="lg">Otros sectores</Button>
      </div>
    </div>
  </section>

</Base>
