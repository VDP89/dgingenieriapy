---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Button from '../../components/Button.astro';

const capacidades = [
  { title: 'Análisis de situaciones portuarias', desc: 'Condiciones del sitio, restricciones operativas, requerimientos logísticos y compatibilidad con la infraestructura existente.', icon: 'anchor' },
  { title: 'Estudios de ingeniería de embarque', desc: 'Evaluación técnica de opciones de embarque, dimensionado preliminar y análisis de alternativas con criterio técnico-económico.', icon: 'ship' },
  { title: 'Coordinación de especialidades', desc: 'Integración de geotecnia, hidrología, topografía, vialidad de accesos y logística operativa en un análisis coherente.', icon: 'link' },
  { title: 'Soluciones técnicas integrales', desc: 'Articulamos cada componente dentro del análisis general del proyecto, asegurando consistencia técnica en el conjunto.', icon: 'puzzle' },
  { title: 'Interconexión de disciplinas', desc: 'Puente entre especialistas: traducción técnica entre disciplinas y consolidación de criterios de proyecto.', icon: 'network' },
];

const experiencia = [
  { label: 'Puerto Torocuá', detail: 'Grupo Favero · Río Paraná' },
  { label: 'Estudios portuarios', detail: 'Análisis de situaciones y coordinación de especialidades' },
  { label: 'Río Paraná', detail: 'Experiencia en infraestructura fluvial paraguaya' },
];
const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Sectores', url: '/sectores' },
  { name: 'Puertos y Fluvial', url: '/sectores/puertos' },
];

---

<Base
  title="Puertos y Fluvial"
  description="Estudios de ingeniería portuaria y fluvial. Análisis de situaciones, coordinación de especialidades e interconexión de disciplinas. Experiencia en Torocuá, río Paraná."
  preloadImg="/img/sector-puertos.jpg"
  breadcrumbs={breadcrumbs}
>

  <PageHero
    img="/img/sector-puertos.jpg"
    imgAlt="Infraestructura portuaria"
    kicker="Sectores · Puertos y fluvial"
    title="Estudios de ingeniería"
    titleAccent="portuaria y fluvial"
    subtitle="Análisis de situaciones portuarias, coordinación de especialidades y soluciones técnicas para infraestructura de embarque."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Consultar proyecto</Button>
    <Button href="/sectores" variant="ghost-dark">Todos los sectores</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Enfoque"
          title="Abordaje"
          titleAccent="multidisciplinario"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>La infraestructura portuaria y fluvial requiere un abordaje multidisciplinario que integre análisis técnicos de diversas especialidades. Realizamos estudios de ingeniería orientados a comprender las situaciones de puertos de embarque: condiciones del sitio, restricciones operativas, requerimientos logísticos y compatibilidad con la infraestructura existente.</p>
        <p>Trabajamos en la interconexión de especialidades: geotecnia, hidrología, topografía, vialidad de accesos y logística operativa. Coordinamos la integración de cada componente dentro del análisis general del proyecto, asegurando consistencia técnica en el conjunto.</p>
        <p>Nuestra experiencia en Puerto Torocuá sobre el río Paraná nos dio la base para abordar este tipo de proyectos con criterio práctico: entender las condiciones reales del sitio, identificar las especialidades necesarias y articular soluciones de ingeniería que respondan a la escala y complejidad de cada caso.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capacidades"
      title="Lo que hacemos"
      lead="Coordinación técnica entre especialidades para estudios portuarios integrales que respondan a la complejidad real de cada sitio."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capacidades.map((c) => (
        <div class="bg-white rounded-xl p-7 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-11 h-11 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            {c.icon === 'anchor' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="5" r="3"/><path d="M12 8v13M5 12H2a10 10 0 0 0 20 0h-3"/></svg>}
            {c.icon === 'ship' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 20a6 6 0 0 0 12 0M14 20a6 6 0 0 0 8 0M12 4v16M4 13l8-8 8 8"/></svg>}
            {c.icon === 'link' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>}
            {c.icon === 'puzzle' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M19 11h2v4a2 2 0 0 1-2 2h-4v2a3 3 0 0 1-6 0v-2H5a2 2 0 0 1-2-2v-4h2a3 3 0 0 0 0-6H3V5a2 2 0 0 1 2-2h4V1a3 3 0 0 1 6 0v2h4a2 2 0 0 1 2 2v4h-2a3 3 0 0 0 0 6z"/></svg>}
            {c.icon === 'network' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 7l3 3m7-3-3 3m-7 7 3-3m7 3-3-3"/></svg>}
          </div>
          <h3 class="text-[17px] font-extrabold tracking-tight mb-2 text-slate-dg">{c.title}</h3>
          <p class="text-[13.5px] text-slate-dg/65 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <FullBleedSection bg="white" padding="md">
    <SectionHeader
      kicker="Proyecto de referencia"
      title="Puerto Torocuá"
      titleAccent="— Grupo Favero"
      class="mb-10"
    />
    <ProjectCard
      kicker="Río Paraná · Grupo Favero"
      title="Estudios de ingeniería portuaria sobre el río Paraná"
      description="Análisis de situaciones portuarias, estudios de ingeniería, interconexión de especialidades y soluciones técnicas para infraestructura de embarque."
      metrics={[
        { label: 'Ubicación', value: 'Río Paraná' },
        { label: 'Cliente', value: 'Grupo Favero' },
        { label: 'Alcance', value: 'Estudios' },
      ]}
      img="/img/proyecto-puertos.jpg"
      imgAlt="Estudios Puerto Torocuá"
      href="/contacto"
      ctaLabel="Consultar proyecto similar"
      variant="dark"
      imageSide="right"
      layout="equal"
    />
  </FullBleedSection>

  <FullBleedSection bg="cream" padding="md">
    <SectionHeader
      kicker="Experiencia"
      title="Trayectoria en infraestructura fluvial"
      lead="Estudios y coordinación técnica para proyectos portuarios sobre el río Paraná y la hidrovía paraguaya."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[900px] mx-auto">
      {experiencia.map((e) => (
        <div class="bg-white rounded-xl p-6 border border-slate-dg/[0.08] flex items-start gap-4" data-animate>
          <div class="w-10 h-10 rounded-full bg-arena/12 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-arena" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 9 8 13 14 5"/></svg>
          </div>
          <div>
            <h4 class="text-[15px] font-extrabold text-slate-dg tracking-tight mb-1">{e.label}</h4>
            <p class="text-[13px] text-slate-dg/60 leading-relaxed">{e.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">¿Tiene un proyecto portuario?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[520px] mx-auto">Estudios de ingeniería, análisis de situaciones o coordinación de especialidades. Hablemos sobre cómo dar claridad técnica al proyecto.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/sectores" variant="ghost-dark" size="lg">Otros sectores</Button>
      </div>
    </div>
  </section>

</Base>
