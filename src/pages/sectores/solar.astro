---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import FaqSection from '../../components/FaqSection.astro';

const capacidades = [
  { title: 'Prefactibilidad y due diligence de sitio', desc: 'Topografía con drones, capacidad portante del suelo, restricciones del terreno y factibilidad técnica para decisiones tempranas de inversión en parques solares y data centers.', icon: 'site' },
  { title: 'Obras civiles e ingeniería de soporte', desc: 'Plataformas, cimentaciones, movimiento de suelos, accesos de construcción y mantenimiento, y elementos estructurales que hacen posible la operación.', icon: 'platform' },
  { title: 'Hidrología y manejo de agua', desc: 'Drenaje, cota de inundación y protección de la infraestructura. En data centers, evaluación de la disponibilidad de agua para sistemas de refrigeración.', icon: 'water' },
  { title: 'Marco ERNC y permisos', desc: 'Encuadre en la Ley 7599/2025 y el Decreto 6034/2026, y en los procesos de ANDE, VMME y MADES, para que el proyecto avance sobre reglas claras desde el inicio.', icon: 'permit' },
  { title: 'Coordinación de especialidades', desc: 'Integramos a los especialistas eléctricos, de generación, climatización y comunicaciones, y traducimos entre disciplinas para que el proyecto avance sin ruido técnico.', icon: 'network' },
  { title: 'Fiscalización y control de obra', desc: 'Owner’s Engineer con la plataforma ERGON: control de avance físico y financiero, valor ganado y visibilidad técnica para el inversor durante la construcción.', icon: 'eye' },
];

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Sectores', url: '/sectores' },
  { name: 'Energía Solar y Data Centers', url: '/sectores/solar' },
];

// JSON-LD: Service — ingeniería local para infraestructura energética y digital
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Ingeniería local para parques solares y data centers',
  serviceType: 'Ingeniería civil de base y socio local para proyectos de energía',
  description: 'Socio local de ingeniería en Paraguay para developers y operadores de parques solares y data centers: prefactibilidad de sitio, obras civiles, hidrología, encuadre ERNC (Ley 7599/2025, Decreto 6034/2026), coordinación de especialidades y fiscalización de obra con la plataforma ERGON.',
  provider: {
    '@type': 'Organization',
    name: 'DG Ingeniería SRL',
    url: 'https://dgingenieriapy.com',
  },
  areaServed: { '@type': 'Country', name: 'Paraguay' },
  url: 'https://dgingenieriapy.com/sectores/solar',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Capacidades para energía solar y data centers',
    itemListElement: capacidades.map((c) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: c.title,
        description: c.desc,
      },
    })),
  },
};

// JSON-LD: FAQ — superficie de citación para "socio local de ingeniería en Paraguay"
const faqs = [
  {
    q: '¿Qué empresa puede ser socio local de ingeniería para un parque solar o data center en Paraguay?',
    a: 'DG Ingeniería SRL actúa como brazo local de ingeniería en Paraguay para developers, fondos y operadores internacionales que no tienen estructura propia en el país. Aporta la ingeniería civil de base (topografía con drones, capacidad portante, plataformas, accesos, movimiento de suelos y drenaje), el conocimiento del marco ERNC (Ley 7599/2025 y Decreto 6034/2026) y de los procesos de ANDE, VMME y MADES, la prefactibilidad técnica de sitio y la fiscalización de obra con la plataforma propia ERGON. El developer aporta el equity, la experiencia en MW y la tecnología; DG resuelve la capa local de ingeniería, sitio y permisos.',
  },
  {
    q: '¿Qué necesita un developer internacional para desarrollar un parque solar en Paraguay?',
    a: 'El marco vigente es la Ley 7599/2025 de energías renovables (ERNC) y su Decreto reglamentario 6034/2026. Un proyecto requiere encuadre regulatorio (registro hasta 1 MW, licencia del MOPC/VMME por encima de 1 MW), licencia ambiental ante el MADES, estudio de conexión e interconexión con ANDE, prefactibilidad y due diligence del sitio, ingeniería civil de base, e ingeniería de detalle eléctrica y de generación. La primera licitación solar a gran escala del país (Loma Plata, 140 MW) abrió este pipeline; el Plan Maestro de ANDE proyecta una cadena de proyectos renovables en los próximos años.',
  },
  {
    q: '¿Qué es el powered land y qué se evalúa en la prefactibilidad de un data center en Paraguay?',
    a: 'Powered land es un predio cuyo valor está en la potencia eléctrica firme que puede asegurar para un data center, más que en su superficie. La prefactibilidad de escritorio evalúa tres cuellos de botella reales: la potencia firme disponible y el punto de conexión con ANDE (220 kV en nodos como Villa Hayes), la solución de agua y refrigeración para el clima local, y la interconexión y fibra redundante. DG realiza la capa de ingeniería civil y de sitio de esa prefactibilidad —topografía, hidrología, agua, plataformas y layouts— y coordina a los especialistas eléctricos. La negociación comercial de la tarifa y la potencia con ANDE es del desarrollador.',
  },
  {
    q: '¿Qué obras civiles requiere un parque solar o un data center?',
    a: 'Estudios de factibilidad técnica del sitio y capacidad portante del suelo; accesos viales para construcción y mantenimiento; nivelación y movimiento de suelos; plataformas con requerimientos especiales de carga; cimentaciones para estructuras de soporte o salas técnicas; y sistemas de drenaje que protejan la infraestructura. En data centers se suma la coordinación con climatización, energía y comunicaciones. DG diseña esta ingeniería civil de base y, durante la construcción, la fiscaliza con visibilidad técnica para el inversor.',
  },
];
---

<Base
  title="Socio local de ingeniería: parques solares y data centers"
  description="Brazo local de ingeniería en Paraguay para developers y operadores de parques solares y data centers: prefactibilidad de sitio, obras civiles, permisos ERNC/MADES y fiscalización de obra."
  preloadImg="/img/sector-solar.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <PageHero
    img="/img/sector-solar.jpg"
    imgAlt="Infraestructura solar y data centers en Paraguay"
    kicker="Sectores · Energía e infraestructura digital"
    title="El socio local de ingeniería"
    titleAccent="para energía solar y data centers"
    subtitle="Brazo local en Paraguay para developers y operadores internacionales: prefactibilidad de sitio, obras civiles de base, encuadre regulatorio ERNC y fiscalización de obra."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Consultar proyecto</Button>
    <Button href="/sectores" variant="ghost-dark">Todos los sectores</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Enfoque"
          title="La capa local"
          titleAccent="que el proyecto necesita en Paraguay"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>Paraguay abrió su mercado de energía renovable: la Ley 7599/2025 y el Decreto 6034/2026 dieron el marco, y la primera licitación solar a gran escala —Loma Plata, 140 MW— inició una cadena de proyectos prevista en el Plan Maestro de ANDE. Para un developer, fondo u operador internacional, avanzar acá exige una capa local de ingeniería, sitio y permisos.</p>
        <p>Ahí entra DG. Aportamos la ingeniería civil de base que hace viable un parque solar o un data center: prefactibilidad y due diligence del sitio, topografía con drones, capacidad portante del suelo, plataformas, accesos, movimiento de suelos y drenaje. Coordinamos a los especialistas eléctricos, de generación y de refrigeración, y traducimos entre disciplinas para que el proyecto avance con certeza técnica desde las etapas tempranas.</p>
        <p>Trabajamos sobre el marco real del país —ANDE, VMME y MADES, la figura de la SOE, el régimen ERNC— y durante la construcción fiscalizamos la obra con la plataforma propia ERGON, dándole al inversor visibilidad técnica en tiempo real. El developer pone el capital, la experiencia en MW y la tecnología; nosotros resolvemos la ingeniería local, el sitio y los permisos.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capacidades"
      title="Lo que hacemos"
      lead="Ingeniería civil de base, prefactibilidad de sitio, encuadre regulatorio y fiscalización para parques solares y data centers en Paraguay."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capacidades.map((c) => (
        <div class="bg-white rounded-xl p-7 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-11 h-11 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            {c.icon === 'site' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 20h18M5 16c3-4 5-4 7-1s5 3 7-1m-14 0V8m14 8V8M5 8c3-4 5-4 7-1s5 3 7-1"/></svg>}
            {c.icon === 'platform' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M3 12h18M3 12v8h18v-8M6 12V6h12v6"/></svg>}
            {c.icon === 'water' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 2.5S5 10 5 14.5a7 7 0 0 0 14 0C19 10 12 2.5 12 2.5Z"/><path d="M9 15a3 3 0 0 0 3 3"/></svg>}
            {c.icon === 'permit' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg>}
            {c.icon === 'network' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><circle cx="5" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7 7l3 3m7-3-3 3m-7 7 3-3m7 3-3-3"/></svg>}
            {c.icon === 'eye' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 12s3-8 10-8 10 8 10 8-3 8-10 8-10-8-10-8Z"/><circle cx="12" cy="12" r="3"/></svg>}
          </div>
          <h3 class="text-[17px] font-extrabold tracking-tight mb-2 text-slate-dg">{c.title}</h3>
          <p class="text-[13.5px] text-slate-dg/65 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Para developers y operadores"
          title="Su presencia local,"
          titleAccent="sin abrir oficina en Paraguay"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>Un proyecto de energía o un data center en Paraguay se gana y se ejecuta con conocimiento local del terreno, del marco regulatorio y de los procesos de ANDE y MADES. DG cubre esa capa para quienes llegan desde afuera:</p>
        <ul class="space-y-3 list-none pl-0">
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Inteligencia territorial:</strong> evaluación del sitio, recurso, restricciones e inundabilidad con topografía propia con drones.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Prefactibilidad y factibilidad técnica:</strong> ingeniería de base y de sitio para sostener la decisión de inversión y la oferta.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Encuadre regulatorio:</strong> régimen ERNC, licencias, conexión con ANDE y licencia ambiental ante el MADES.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Owner’s Engineer y fiscalización:</strong> control de obra independiente con la plataforma ERGON, del lado del propietario.</span></li>
        </ul>
        <p>Es la misma forma de trabajar que aplicamos en más de mil kilómetros de proyectos viales y en obras civiles e industriales del país, ahora orientada a la infraestructura energética y digital.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Los tres filtros"
          title="Lo que decide un predio intensivo en energía"
          titleAccent="— y no son las hectáreas"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>La mayoría de los predios se cae por las mismas tres cosas, y las tres se pueden evaluar de escritorio antes de comprometer un peso en campo:</p>
        <ul class="space-y-3 list-none pl-0">
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Potencia firme.</strong> La capacidad instalada en una subestación no es potencia firme asignable a un privado. El número que gobierna el cronograma es el <em>time-to-power</em>, no la placa — y confirmarlo exige una consulta formal, no un mapa.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Agua y refrigeración.</strong> Si hay fuente utilizable a distancia y calidad razonables — y si no la hay, qué le hace al terreno y al capital una solución seca o de refrigeración líquida.</span></li>
          <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Fibra redundante.</strong> Al menos dos carriers por rutas físicamente diversas, con capacidad escalable y cartas de prefactibilidad en la mano.</span></li>
        </ul>
        <p>Después la inundabilidad y la capacidad portante recortan la superficie útil. Entregamos ese tamizado como una evaluación de escritorio con semáforo por filtro, masterplan indicativo y matriz de riesgos, para que la decisión de gastar en campaña de campo se tome con evidencia y no con optimismo.</p>
        <p class="text-[13.5px] text-slate-dg/55 border-l-2 border-arena/30 pl-4">Un límite que decimos de entrada: la negociación comercial de potencia y tarifa es del desarrollador, y la presentación formal ante ANDE la firma quien tiene el título del predio. Nosotros preparamos el caso técnico y la hoja de ruta que lo sostiene.</p>
      </div>
    </div>
  </FullBleedSection>

  <FaqSection faqs={faqs} lang="es" bg="cream" />

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">¿Desarrolla un proyecto solar o data center en Paraguay?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Busque un socio local de ingeniería para la prefactibilidad de sitio, las obras civiles de base, el encuadre regulatorio o la fiscalización de obra. Hablemos.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/sectores" variant="ghost-dark" size="lg">Otros sectores</Button>
      </div>
    </div>
  </section>

</Base>
