---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import FullBleedSection from '../../../components/FullBleedSection.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import SectorCard from '../../../components/SectorCard.astro';
import Button from '../../../components/Button.astro';
import { nav } from '../../../i18n/ui';
import { homeContent } from '../../../i18n/home';

const N = nav('en');
// Mismo contenido de sectores que el home EN — una sola definicion, sin copia divergente.
const sectors = homeContent.en.sectors;

const sectorHref: Record<string, string> = {
  vialidad: N.vialidad,
  pavimentos: N.pavimentos,
  aeropuertos: N.aeropuertos,
  puertos: N.puertos,
  fiscalizacion: N.fiscalizacion,
  'plantas-industriales': N.plantas,
  urbanizaciones: N.urbanizaciones,
  solar: N.solar,
  'relevamiento-aereo': N.relevamiento,
};

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Sectors', url: '/en/sectors' },
];
---

<Base
  title="Civil engineering sectors in Paraguay"
  description="Nine areas of civil engineering specialisation in Paraguay: site feasibility, solar and data centers, land development, roads, pavements, airports, ports, industrial plants and aerial survey."
  preloadImg="/img/destacado-bid.webp"
  breadcrumbs={breadcrumbs}
>

  <PageHero
    img="/img/destacado-bid.jpg"
    imgAlt="DG Ingeniería infrastructure projects"
    kicker="Areas of specialisation"
    title="Nine sectors,"
    titleAccent="one way of working"
    subtitle="Delivered projects behind each sector, and a single method that runs from feasibility through to construction control."
    height="md"
  >
    <Button href="#sectors" variant="primary" magnetic>Explore sectors</Button>
    <Button href={N.contact} variant="ghost-dark">Start a conversation</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md" id="sectors">
    <SectionHeader
      kicker="Our sectors"
      title="Specialisation"
      titleAccent="that still talks to itself"
      lead="Every sector is approached the same way: measured data from the start, technical coordination across disciplines, and control at each stage. The sectors are separate; the team is not."
      align="center"
      class="mb-14"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sectors.map((s) => (
        <SectorCard
          slug={s.slug}
          title={s.title}
          desc={s.desc}
          img={s.img}
          tag={s.tag}
          href={sectorHref[s.slug]}
          ctaLabel="View sector"
        />
      ))}
    </div>
  </FullBleedSection>

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-[10%] left-[10%] w-[400px] h-[400px] border border-cream/[0.03] rounded-full"></div>

    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">Looking for a specific capability?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[520px] mx-auto">Tell us what stage your project is at and we will tell you where we fit — and where you need someone else.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={N.contact} variant="primary" size="lg">Start a conversation</Button>
        <Button href={N.projects} variant="ghost-dark" size="lg">See projects</Button>
      </div>
    </div>
  </section>

</Base>
