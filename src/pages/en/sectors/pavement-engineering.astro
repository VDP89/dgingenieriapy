---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import FullBleedSection from '../../../components/FullBleedSection.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Button from '../../../components/Button.astro';
import { nav } from '../../../i18n/ui';

const N = nav('en');

const capabilities = [
  { title: 'Flexible pavements (AASHTO)', desc: 'Asphalt structure design under the AASHTO 93 methodology, calibrated to local conditions and to the project’s real loading.', icon: 'layers' },
  { title: 'Rigid pavements', desc: 'Concrete slab design against fatigue and load transfer criteria, with the construction details worked through.', icon: 'grid' },
  { title: 'Deflectometry', desc: 'Structural evaluation by non-destructive testing, back-calculating effective layer moduli to diagnose the real condition.', icon: 'wave' },
  { title: 'Overlays and rehabilitation', desc: 'Overlays, cold recycling, milling and selective replacement, with a distress inventory classified and quantified.', icon: 'tool' },
  { title: 'Industrial pavements', desc: 'Designed for the point and concentrated loads of industrial operations: hardstands, heavy access, logistics platforms.', icon: 'factory' },
  { title: 'Low-volume roads', desc: 'Solutions for rural and secondary roads: cobblestone, block paving, bituminous surface treatments and penetration macadam.', icon: 'road' },
];

const experience = [
  { label: 'More than 25 projects', detail: 'Delivered with DG design and/or supervision' },
  { label: 'Asphalt, concrete, cobblestone, block paving', detail: 'Experience across the main pavement types' },
  { label: 'AASHTO and MEPDG', detail: 'International methodologies applied with local calibration' },
  { label: 'Multi-regional coverage', detail: 'Projects across different regions of the country' },
];

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Sectors', url: '/en/sectors' },
  { name: 'Pavement Engineering', url: '/en/sectors/pavement-engineering' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Pavement evaluation, design and rehabilitation',
  serviceType: 'Structural pavement engineering',
  description: 'Pavement engineering in Paraguay: structural evaluation by deflectometry, flexible pavement design under AASHTO 93, rigid pavement design, overlays and rehabilitation strategies, industrial pavements and low-volume road solutions.',
  provider: {
    '@type': 'Organization',
    '@id': 'https://dgingenieriapy.com/#organization',
    name: 'DG Ingeniería SRL',
    url: 'https://dgingenieriapy.com',
  },
  areaServed: { '@type': 'Country', name: 'Paraguay' },
  url: 'https://dgingenieriapy.com/en/sectors/pavement-engineering',
  inLanguage: 'en',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Capabilities',
    itemListElement: capabilities.map((c) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: c.title, description: c.desc },
    })),
  },
};
---

<Base
  title="Pavement evaluation and design in Paraguay"
  description="Pavement evaluation and design in Paraguay: deflectometry, AASHTO 93 and MEPDG for flexible, rigid, block, cobblestone and industrial pavements. Over 25 projects."
  preloadImg="/img/sector-pav.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <PageHero
    img="/img/sector-pav.jpg"
    imgAlt="Pavement evaluation"
    kicker="Sectors · Pavements"
    title="Pavement evaluation"
    titleAccent="and design"
    subtitle="Deflectometry, AASHTO and MEPDG across every pavement type: flexible, rigid, cobblestone, block paving and industrial."
    height="md"
  >
    <Button href={N.contact} variant="primary" magnetic>Discuss a project</Button>
    <Button href={N.sectors} variant="ghost-dark">All sectors</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Approach"
          title="Pavement evaluation"
          titleAccent="and design"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>How a pavement behaves depends on several variables at once: traffic loading, subgrade support, available materials and climate. We evaluate each project with deflectometry testing, which lets us back-calculate the effective modulus of each layer and diagnose the real structural condition rather than the assumed one.</p>
        <p>We work across every pavement type the project may call for: asphalt, concrete, cobblestone, block paving and low-volume roads. In each case we apply AASHTO and MEPDG methodologies adapted to local conditions, material availability and construction experience.</p>
        <p>For pavements already in service, we design optimized strengthening and rehabilitation strategies, with a distress inventory, failure classification and quantification precise enough to budget the intervention.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capabilities"
      title="What we do"
      lead="Pavement evaluation and design in Paraguay: deflectometry, AASHTO 93 and MEPDG for flexible, rigid, block, cobblestone and industrial pavements. Over 25 projects."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capabilities.map((c) => (
        <div class="bg-white rounded-xl p-7 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-11 h-11 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            {c.icon === 'layers' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="m12 3-9 5 9 5 9-5-9-5Zm-9 11 9 5 9-5M3 11l9 5 9-5"/></svg>}
            {c.icon === 'grid' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>}
            {c.icon === 'wave' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0 4 3 6 0"/></svg>}
            {c.icon === 'tool' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>}
            {c.icon === 'factory' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M2 20V8l6 4V8l6 4V8l6 4v8H2Zm4 0v-4m4 4v-4m4 4v-4m4 4v-4"/></svg>}
            {c.icon === 'road' && <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 22 10 2M20 22 14 2M12 6v2m0 4v2m0 4v2"/></svg>}
          </div>
          <h3 class="text-[17px] font-extrabold tracking-tight mb-2 text-slate-dg">{c.title}</h3>
          <p class="text-[13.5px] text-slate-dg/65 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream" padding="md">
    <SectionHeader
      kicker="Experience"
      title="Experience"
      lead="Pavement design and supervision across pavement types and regions."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[900px] mx-auto">
      {experience.map((e) => (
        <div class="bg-white rounded-xl p-6 border border-slate-dg/[0.08] flex items-start gap-4" data-animate>
          <div class="w-10 h-10 rounded-full bg-arena/12 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-arena" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 18 18"><polyline points="4 9 8 13 14 5"/></svg>
          </div>
          <div>
            <h4 class="text-[15px] font-extrabold text-slate-dg tracking-tight mb-1">{e.label}</h4>
            <p class="text-[13px] text-slate-dg/60 leading-relaxed">{e.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">Working on a pavement project?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">New design, structural evaluation or a rehabilitation strategy — tell us the condition and we will tell you what the testing needs to show.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={N.contact} variant="primary" size="lg">Start a conversation</Button>
        <Button href={N.sectors} variant="ghost-dark" size="lg">Other sectors</Button>
      </div>
    </div>
  </section>

</Base>
