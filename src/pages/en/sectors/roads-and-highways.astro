---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import FullBleedSection from '../../../components/FullBleedSection.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Button from '../../../components/Button.astro';
import { nav } from '../../../i18n/ui';

const N = nav('en');

const capabilities = [
  { title: 'Geometric design', desc: 'Horizontal and vertical alignment and cross sections, against criteria of safety, operability and buildability.', icon: 'route' },
  { title: 'Traffic studies', desc: 'Volumes, vehicle composition and flow behaviour, to size each element of the infrastructure.', icon: 'traffic' },
  { title: 'Topographic survey', desc: 'Photogrammetric and conventional techniques, producing the precision base mapping that lets an alignment be optimised.', icon: 'topo' },
  { title: 'Pavement structural analysis', desc: 'Load capacity verification, improvement alternatives and sizing on technical and economic criteria.', icon: 'layers' },
  { title: 'Road hydraulics and drainage', desc: 'Reconciled with the relief and the local context, with critical sections verified through specific modeling.', icon: 'water' },
  { title: 'Feasibility and SNIP', desc: 'Technical, economic and environmental feasibility documentation under SNIP, Paraguay’s public-investment methodology, for multilateral programmes.', icon: 'docs' },
  { title: 'Audit and design review', desc: 'Verification of regulatory compliance and design consistency, and review of budgets and technical specifications.', icon: 'audit' },
];

const experience = [
  { label: 'National highways', detail: 'Design and supervision on MOPC works' },
  { label: 'IDB and CAF programmes', detail: 'Direct contractor to multilateral institutions' },
  { label: 'CREMA and CCOMA programmes', detail: 'Performance-based road maintenance and conservation' },
  { label: 'Departmental roads', detail: 'Support to regional and municipal governments' },
];

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Sectors', url: '/en/sectors' },
  { name: 'Roads & Highways', url: '/en/sectors/roads-and-highways' },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Highway and road engineering',
  serviceType: 'Highway design, feasibility and technical audit',
  description: 'Highway and road engineering in Paraguay: geometric design, traffic studies, topographic survey, pavement structural analysis, road hydraulics and drainage, feasibility documentation under the SNIP public-investment methodology, and technical audit of third-party designs.',
  provider: {
    '@type': 'Organization',
    '@id': 'https://dgingenieriapy.com/#organization',
    name: 'DG Ingeniería SRL',
    url: 'https://dgingenieriapy.com',
  },
  areaServed: { '@type': 'Country', name: 'Paraguay' },
  url: 'https://dgingenieriapy.com/en/sectors/roads-and-highways',
  inLanguage: 'en',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Capabilities',
    itemListElement: capabilities.map((c) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: c.title, description: c.desc },
    })),
  },
};
---

<Base
  title="Highway and road design in Paraguay"
  description="Highway and road design in Paraguay: feasibility studies, detailed design, technical audit, traffic studies and drainage. IDB and CAF programmes, MOPC, CREMA and CCOMA."
  preloadImg="/img/sector-vial.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <PageHero
    img="/img/sector-vial.jpg"
    imgAlt="Highway project in Paraguay"
    kicker="Sectors · Roads and highways"
    title="Highway and road"
    titleAccent="design"
    subtitle="Feasibility studies, detailed design, topographic survey and technical audit for roads and highways."
    height="md"
  >
    <Button href={N.contact} variant="primary" magnetic>Discuss a project</Button>
    <Button href={N.sectors} variant="ghost-dark">All sectors</Button>
  </PageHero>

  <FullBleedSection bg="white" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <SectionHeader
          kicker="Approach"
          title="Highway and road"
          titleAccent="design"
        />
      </div>
      <div class="lg:col-span-7 space-y-5 text-[15px] text-slate-dg/75 leading-relaxed">
        <p>We take on highway projects from feasibility studies and SNIP documentation through to detailed design and the review of designs produced by others.</p>
        <p>Geometric design follows criteria of road safety, operability and buildability. We apply national and international standards, working from real operating speeds, safe curve radii and widening for vehicle swept paths.</p>
        <p>During construction we provide full technical control, with periodic progress reports, test documentation and photographic records.</p>
      </div>
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capabilities"
      title="What we do"
      lead="Highway and road design in Paraguay: feasibility studies, detailed design, technical audit, traffic studies and drainage. IDB and CAF programmes, MOPC, CREMA and CCOMA."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {capabilities.map((c) => (
        <div class="bg-white rounded-xl p-7 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-11 h-11 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            <!-- Icon strategy: a curated set per capability -->
            {c.icon === 'route' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M4 19h6a4 4 0 0 0 0-8H8a4 4 0 0 1 0-8h10M4 19l3-3m-3 3 3 3M20 3l-3 3m3-3-3-3"/>
              </svg>
            )}
            {c.icon === 'traffic' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M9 20H4V4h5m6 0h5v16h-5M9 8h6M9 12h6M9 16h6"/>
              </svg>
            )}
            {c.icon === 'topo' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M3 20h18M5 16c3-4 5-4 7-1s5 3 7-1m-14 0V8m14 8V8M5 8c3-4 5-4 7-1s5 3 7-1"/>
              </svg>
            )}
            {c.icon === 'layers' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="m12 3-9 5 9 5 9-5-9-5Zm-9 11 9 5 9-5M3 11l9 5 9-5"/>
              </svg>
            )}
            {c.icon === 'water' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M12 2s6 8 6 13a6 6 0 0 1-12 0c0-5 6-13 6-13Z"/>
              </svg>
            )}
            {c.icon === 'docs' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path d="M14 2v6h6M9 13h6M9 17h6"/>
              </svg>
            )}
            {c.icon === 'audit' && (
              <svg class="w-5 h-5 text-arena" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7"/><path d="m20 20-4.35-4.35M9 11l2 2 4-4"/>
              </svg>
            )}
          </div>
          <h3 class="text-[17px] font-extrabold tracking-tight mb-2 text-slate-dg">{c.title}</h3>
          <p class="text-[13.5px] text-slate-dg/65 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <FullBleedSection bg="cream" padding="md">
    <SectionHeader
      kicker="Experience"
      title="Experience"
      lead="Highway projects for national agencies and multilateral programmes."
      align="center"
      class="mb-14"
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[900px] mx-auto">
      {experience.map((e) => (
        <div class="bg-white rounded-xl p-6 border border-slate-dg/[0.08] flex items-start gap-4" data-animate>
          <div class="w-10 h-10 rounded-full bg-arena/12 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-arena" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 18 18"><polyline points="4 9 8 13 14 5"/></svg>
          </div>
          <div>
            <h4 class="text-[15px] font-extrabold text-slate-dg tracking-tight mb-1">{e.label}</h4>
            <p class="text-[13px] text-slate-dg/60 leading-relaxed">{e.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">Working on a highway project?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Feasibility, detailed design or an independent review of someone else’s design — tell us the stage.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={N.contact} variant="primary" size="lg">Start a conversation</Button>
        <Button href={N.sectors} variant="ghost-dark" size="lg">Other sectors</Button>
      </div>
    </div>
  </section>

</Base>
