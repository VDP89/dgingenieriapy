---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Contact', url: '/en/contact' },
];

---

<Base
  title="Contact"
  description="Contact DG Ingeniería SRL — civil engineering in Paraguay. Site feasibility, project development and construction supervision. Asunción, Paraguay."
  breadcrumbs={breadcrumbs}
>

  <!-- HERO -->
  <section class="bg-slate-dg text-cream py-16 md:py-28">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-4">Contact</h1>
      <p class="text-lg text-cream/65 max-w-2xl leading-relaxed">Write to us about a technical question, a project you are assessing, or a possible collaboration.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- FORM -->
        <div>
          <ContactForm lang="en" />
        </div>

        <!-- CONTACT INFO -->
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-8">Contact details</h2>

          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Email</h3>
            <a
              href="mailto:info@dgingenieriasrl.com"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              info@dgingenieriasrl.com
            </a>
            <p class="text-sm text-gray-neutral mt-2">We reply within 48 business hours, in English or Spanish.</p>
          </div>

          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Phone</h3>
            <a
              href="tel:+595976335132"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              +595 976 335 132
            </a>
            <p class="text-sm text-gray-neutral mt-2">Monday to Friday, 08:30 to 18:00 Paraguay time (UTC-3).</p>
          </div>

          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Location</h3>
            <p class="text-lg font-medium text-slate-dg mb-1">Asunción</p>
            <p class="text-sm text-gray-neutral">Paraguay</p>
          </div>

          <div class="mt-12 p-6 rounded-lg bg-cream-deep border border-slate-dg/10">
            <h3 class="font-semibold text-slate-dg mb-3">What we are usually asked</h3>
            <ul class="space-y-2 text-sm text-slate-dg/80">
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Whether a site works for a specific use — power, water, flooding, access</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>What the local regulatory path looks like, and how long it takes</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Engineering studies and design for a project already under way</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Independent construction supervision on the owner’s behalf</span>
              </li>
            </ul>
            <p class="text-xs text-gray-neutral mt-4">If a confidentiality agreement needs to be in place before scope is discussed, say so in your message and we will sign one first.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-dg text-cream text-center py-16 md:py-20">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">Working to a deadline?</h2>
      <p class="text-base text-cream/50 mb-8 max-w-[440px] mx-auto">Call the number above during Paraguay business hours, or say so in your message and we will prioritise it.</p>
    </div>
  </section>

</Base>
