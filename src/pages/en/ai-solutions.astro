---
import Base from '../../layouts/Base.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import Button from '../../components/Button.astro';
import { nav } from '../../i18n/ui';

const N = nav('en');

const inDevelopment = [
  { name: 'SOLÓN', disc: 'Tenders and bidding documents' },
  { name: 'CALÍMACO', disc: 'Technical specifications' },
  { name: 'AMÍLCAR', disc: 'Pavements' },
  { name: 'POSEIDÓN', disc: 'Hydrology and hydraulics' },
  { name: 'ANTEO', disc: 'Geotechnics and slopes' },
  { name: 'EUCLIDES', disc: 'Highway geometric design' },
];

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'AI Solutions', url: '/en/ai-solutions' },
];

const ergonSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': 'https://ergonpy.com/#software',
  name: 'ERGON',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Construction management software',
  operatingSystem: 'Web',
  url: 'https://ergonpy.com/',
  description:
    'Construction budgeting and control platform: quantity take-off, unit price analysis, program, S-curve and earned value (EVM), requests for information, inspections and document control. Built by DG Ingeniería out of projects delivered in Paraguay.',
  inLanguage: 'es',
  author: { '@id': 'https://dgingenieriapy.com/#organization' },
  publisher: { '@id': 'https://dgingenieriapy.com/#organization' },
  featureList: [
    'Quantity take-off and budget schedule',
    'Unit price analysis with a reusable item bank',
    'Construction program and S-curve',
    'Earned value: BAC, PV, EV, AC, SPI, CPI',
    'Requests for information (RFI) and inspections',
    'Document control on an auditable baseline',
  ],
};
---

<Base
  title="AI tools for civil engineering"
  description="Software and AI tools built by DG Ingeniería for civil engineering work. ERGON, for construction budgeting and control, is available now."
  breadcrumbs={breadcrumbs}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ergonSchema)} />

  <!-- HERO -->
  <section class="relative bg-slate-dg overflow-hidden min-h-[54vh] flex items-center" data-hero>
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-[-12%] right-[-6%] w-[440px] h-[440px] border border-cream/[0.04] rounded-full"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 py-24 w-full">
      <div class="max-w-[680px]">
        <div class="flex items-center gap-3 mb-8">
          <div class="h-px w-10 bg-arena"></div>
          <span class="text-[11px] font-semibold tracking-[3px] uppercase text-arena">AI Solutions</span>
        </div>
        <h1 class="text-display text-cream text-4xl md:text-[54px] lg:text-[60px] mb-6 leading-[1.05]">
          Tools for<br /><span class="text-arena">civil engineering</span>
        </h1>
        <p class="text-[17px] leading-relaxed text-cream/70 max-w-[540px]">
          ERGON is available now for construction budgeting and control. The rest are in development. We build these because we use them: the tools come out of the engineering work, not the other way round.
        </p>
      </div>
    </div>
  </section>

  <!-- AVAILABLE -->
  <FullBleedSection bg="white" padding="md">
    <span class="text-[11px] font-bold tracking-[3px] uppercase text-arena mb-6 block">Available</span>
    <a
      href="https://ergonpy.com/"
      target="_blank"
      rel="noopener"
      class="group block border-l-2 border-arena bg-cream-deep/40 hover:bg-cream-deep/70 transition-colors rounded-r-lg pl-6 pr-6 md:pl-8 md:pr-8 py-6 md:py-7 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena focus-visible:ring-offset-2 focus-visible:ring-offset-white"
      aria-label="Open ERGON at ergonpy.com"
    >
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
        <div class="max-w-[640px]">
          <h2 class="text-2xl md:text-[26px] font-extrabold tracking-tight text-slate-dg">ERGON</h2>
          <p class="text-gray-neutral text-[15px] mt-1 font-medium">Construction budgeting and control</p>
          <p class="text-slate-dg/70 text-[14.5px] leading-relaxed mt-3">
            A web platform to budget a project and then control it against that budget. It covers
            quantity take-off, unit price analysis against a reusable item bank, the construction
            program with its S-curve, and earned value tracking — plus requests for information,
            inspections and document control on an auditable baseline.
          </p>
          <p class="text-slate-dg/55 text-[13px] leading-relaxed mt-3">
            The interface is in Spanish. Written for the Paraguayan and regional construction market.
          </p>
          <ul class="flex flex-wrap gap-2 mt-4">
            {['Quantity take-off', 'Unit price analysis', 'S-curve', 'Earned value (EVM)', 'RFI and inspections'].map((f) => (
              <li class="text-[12px] font-semibold text-gray-neutral bg-white px-2.5 py-1 rounded border border-slate-dg/[0.10]">{f}</li>
            ))}
          </ul>
        </div>
        <span class="inline-flex items-center gap-1.5 text-slate-dg font-semibold text-[14px] whitespace-nowrap md:mt-1">
          Open ERGON
          <span class="text-arena inline-block group-hover:translate-x-0.5 transition-transform">&#8599;</span>
        </span>
      </div>
    </a>
  </FullBleedSection>

  <!-- IN DEVELOPMENT -->
  <FullBleedSection bg="cream" padding="md" border="top">
    <span class="text-[11px] font-bold tracking-[3px] uppercase text-gray-neutral mb-6 block">In development</span>
    <ul>
      {inDevelopment.map((t) => (
        <li class="py-5 border-b border-slate-dg/[0.08]">
          <h3 class="text-lg font-bold tracking-tight text-slate-dg">{t.name}</h3>
          <p class="text-gray-neutral text-[14px] mt-1">{t.disc}</p>
        </li>
      ))}
    </ul>
  </FullBleedSection>

  <!-- CTA -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">A project where these tools would help?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Tell us what you are trying to control and we will tell you whether the tooling fits.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={N.contact} variant="primary" size="lg">Start a conversation</Button>
        <Button href="https://ergonpy.com/" variant="ghost-dark" size="lg">Open ERGON</Button>
      </div>
    </div>
  </section>

</Base>
