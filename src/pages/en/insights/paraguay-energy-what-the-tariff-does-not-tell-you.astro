---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import FullBleedSection from '../../../components/FullBleedSection.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Button from '../../../components/Button.astro';
import FaqSection from '../../../components/FaqSection.astro';
import { nav } from '../../../i18n/ui';

const N = nav('en');

const pubDate = '19 August 2026';
const readTime = '6 min read';

const titulo = "What Paraguay's energy tariff doesn't tell a foreign investor";
const desc = 'Paraguay really does have abundant, low-cost hydroelectric power. Three things that story leaves out are what actually govern whether an energy-intensive project gets built, and when.';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: desc,
  image: 'https://dgingenieriapy.com/img/insight-energia-paraguay.jpg',
  author: { '@id': 'https://victordelpuerto.com/#person' },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://dgingenieriapy.com/#organization',
    name: 'DG Ingeniería SRL',
    logo: {
      '@type': 'ImageObject',
      url: 'https://dgingenieriapy.com/img/dg-isotipo.png',
    },
  },
  datePublished: '2026-08-19',
  dateModified: '2026-08-19',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://dgingenieriapy.com/en/insights/paraguay-energy-what-the-tariff-does-not-tell-you/',
  },
  inLanguage: 'en',
  articleSection: 'Energy and site decisions in Paraguay',
  keywords: 'invest in Paraguay, Paraguay electricity tariff, data center Paraguay, time to power, firm power, site selection Paraguay, hydroelectric Paraguay, owner’s engineer Paraguay, energy intensive investment',
};

const faqs = [
  {
    q: 'Is electricity really cheap in Paraguay?',
    a: 'Yes, and the surplus is real — the country produces far more electricity than it consumes. Two qualifications matter for an investment model. The tariff is denominated in guaraníes, so the cost measured in dollars moves with the exchange rate even when the tariff schedule itself is untouched. And for large, intensive consumption the applicable figure is not published: it is established through a special contract with the utility. A dollar-per-megawatt-hour figure quoted from a report is a snapshot of an exchange rate on a date, not a fixed property of the country.',
  },
  {
    q: 'What decides whether a site in Paraguay works for an energy-intensive project?',
    a: 'Three filters, and none of them is the size of the plot. Firm power that can actually be assigned to a private offtaker at that node, and the time required to make it available. Water and cooling, or what it costs to design without them. And redundant fibre on physically diverse routes. Flood exposure and bearing capacity then narrow the usable area further. All three can be screened from a desk, before any field campaign is committed and before a purchase option is signed.',
  },
  {
    q: 'How long does it take to get power for a large project in Paraguay?',
    a: 'There is a published administrative procedure for connecting a large load, with defined steps and response times, and it contains expiry clocks that can lapse a submission if it is not followed through. But the published procedure has an upper band, and above it no equivalent published timetable takes its place. For a project in the tens or hundreds of megawatts there is no calendar to look up: the schedule has to be built from the specific case, the point of connection and the works involved.',
  },
  {
    q: 'Why does the date matter so much when reading about Paraguayan energy regulation?',
    a: 'Because the framework governing energy-intensive investment has been under active revision through 2026, with regimes introduced and withdrawn inside the same year. Published analysis does not update itself when a rule changes, so material written eighteen months ago can accurately describe something that no longer applies. Any statement about tariff, regime or incentive should carry the date on which it was verified — including this article, which reflects the position as of 19 August 2026.',
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/en/' },
  { name: 'Insights', url: '/en/insights' },
  { name: 'What Paraguay’s energy tariff doesn’t tell a foreign investor', url: '/en/insights/paraguay-energy-what-the-tariff-does-not-tell-you' },
];
---

<Base
  title={titulo}
  description={desc}
  ogImage="/img/insight-energia-paraguay.jpg"
  preloadImg="/img/insight-energia-paraguay.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <PageHero
    img="/img/insight-energia-paraguay.jpg"
    imgAlt="Stepped load curve rising within a published procedure and continuing as a dotted line above its upper band"
    kicker="Insights · Energy and site decisions"
    title="What Paraguay’s energy tariff"
    titleAccent="doesn’t tell a foreign investor"
    subtitle="The cheap power is real. Three things that story leaves out are what decide whether a project gets built, and when."
    height="md"
  >
    <Button href={N.contact} variant="primary" magnetic>Start a conversation</Button>
    <Button href={N.insights} variant="ghost-dark">More Insights</Button>
  </PageHero>

  <!-- Meta info -->
  <section class="border-b border-slate-dg/10 bg-cream">
    <div class="max-w-[820px] mx-auto px-5 md:px-8 py-5 flex items-center gap-5 text-[12.5px] text-slate-dg/55 tracking-wide">
      <span class="font-semibold uppercase tracking-[2px] text-arena/85 text-[11px]">Insight #3</span>
      <span aria-hidden="true">·</span>
      <span>{pubDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </section>

  <!-- HOOK -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <p class="text-[19px] text-slate-dg leading-[1.7] font-medium">
        Almost every conversation about investing in Paraguay opens the same way: abundant hydroelectric power, among the lowest industrial tariffs in the region, a country that exports far more electricity than it consumes.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        All of that is accurate. It is also where most analyses stop.
      </p>

      <p>
        The three things that come after are the ones that decide whether a capital-intensive project gets built, and on what timetable. We write this from the owner’s side of the table, and none of it is a reason not to invest here. It is what we would want to know before signing anything.
      </p>
    </article>
  </FullBleedSection>

  <!-- 1 -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="One"
        title="The tariff is priced in guaraníes."
        titleAccent="Your model is not."
      />

      <p>
        Paraguay’s electricity tariff is published in guaraníes per kilowatt-hour. Your investment committee thinks in dollars. Those two facts are not a detail.
      </p>

      <p>
        A tariff schedule can stay completely untouched for two years while the cost of that same energy, measured in dollars, moves materially — in either direction — purely because the guaraní moved. There is no announcement when this happens, because nothing was announced. Nobody changed the tariff.
      </p>

      <p>
        The practical consequence is that a dollar-per-megawatt-hour figure quoted from a report is a snapshot of an exchange rate on a particular date, not a fixed property of the country. If you are modelling a twenty-year offtake, the currency of denomination belongs in your sensitivity analysis alongside the tariff itself.
      </p>

      <p class="text-[14.5px] text-slate-dg/55 border-l-2 border-arena/30 pl-4">
        As of 19 August 2026 the reference rate was 6,020 guaraníes to the dollar. Check the Central Bank series for whatever date your model uses.
      </p>
    </article>
  </FullBleedSection>

  <!-- 2 -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Two"
        title="The constraint is not generation."
        titleAccent="It is transmission."
      />

      <p>
        The surplus is real: Paraguay consumes a fraction of what it produces and exports the rest. From that, a reasonable person concludes that power is available.
      </p>

      <p>
        Generation and delivery are different questions. The capacity that matters to a project is the capacity that can reach <em>your</em> site, at <em>your</em> voltage, with the redundancy your operation requires. That is a transmission and substation question, and it is where the system is tight — tight enough that the country has experienced supply events despite the surplus.
      </p>

      <p>
        So the number that governs a schedule is not the installed capacity of a nearby substation. It is the firm capacity that can actually be assigned to a private offtaker at that node, and the time it takes to make it available. We call that second figure <strong class="text-slate-dg">time-to-power</strong>, and it is the one that moves an investment date.
      </p>
    </article>
  </FullBleedSection>

  <!-- 3 -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Three"
        title="For a large load, the tariff is not a number."
        titleAccent="It is a contract."
      />

      <p>
        Below a certain size, you look up your tariff. Above it, you negotiate one.
      </p>

      <p>
        Paraguay’s regime for large, intensive consumption — the category a data center, a large industrial plant or a similar load falls into — works through a special contract with the utility. The published schedule creates the category and then refers to the contract. Which means the answer to “what will power cost me” is not something you can look up. It is something you establish, with terms, conditions and a duration attached.
      </p>

      <p>
        This is neither good news nor bad news. It is a different kind of question than the one most investors arrive with, and it changes who needs to be at the table, and when.
      </p>
    </article>
  </FullBleedSection>

  <!-- El techo -->
  <FullBleedSection bg="cream-deep" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="The clock nobody mentions"
        title="The published procedure"
        titleAccent="has a ceiling"
      />

      <p>
        There is a published administrative procedure for connecting a large load, with defined steps and response times. We have read it, and two things are worth knowing before you plan around it.
      </p>

      <p>
        The first is that it contains expiry clocks. A submission that is not followed through within a defined window lapses, and the process restarts. That makes the <em>sequence</em> of your decisions matter as much as the decisions themselves: filing early, just to have the answer, can mean filing twice.
      </p>

      <p>
        The second is more consequential. The published procedure has an upper band. Above it, the procedure as written does not apply — and no equivalent published timetable takes its place. For a project in the tens or hundreds of megawatts, there is no calendar you can look up.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        For a large load in Paraguay, time-to-power is not something you consult. It is something you construct.
      </p>
    </article>
  </FullBleedSection>

  <!-- Vigencia -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="A note on dates"
        title="The frame is moving,"
        titleAccent="and that matters more than usual"
      />

      <p>
        Through 2026 the framework governing energy-intensive investment in Paraguay has been under active revision. Regimes have been introduced and withdrawn inside the same year.
      </p>

      <p>
        The consequence for a foreign investor is specific and unglamorous: <strong class="text-slate-dg">any statement about tariff, regime or incentive has to carry the date it was true.</strong> A well-written analysis published eighteen months ago can describe something that no longer exists, and it will not announce that it has expired.
      </p>

      <p>
        That applies to what you are reading now, which is why it is dated.
      </p>
    </article>
  </FullBleedSection>

  <!-- Secuencia -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="What this changes"
        title="Screen the site"
        titleAccent="before you buy it"
      />

      <p>
        Most site decisions arrive in the same order: find the land, then check the power. In Paraguay, for an energy-intensive use, that order is expensive.
      </p>

      <p>
        The three filters that decide a site — firm power, water and cooling, redundant fibre — can all be screened from a desk, before any field campaign is committed and before a purchase option is signed. Flood exposure and bearing capacity then narrow the usable area further.
      </p>

      <p>
        Screening first is not caution. It is the cheapest step in the whole sequence, and the only one that can return a “no” while a “no” is still free.
      </p>
    </article>
  </FullBleedSection>

  <!-- Frontera -->
  <FullBleedSection bg="white" padding="md" border="top">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Scope"
        title="Where our work ends"
        titleAccent="— and whose it is after that"
      />

      <p>
        We think the boundary is worth stating plainly, because it is what makes the rest credible.
      </p>

      <ul class="space-y-3 list-none pl-0">
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">We resolve</strong> the site and the engineering: survey and terrain modelling, hydrology and flood exposure, earthworks and platforms, access for heavy transport, net usable area, and the technical case and roadmap through the institutions.</span></li>
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">We coordinate</strong> what specialists must sign: geotechnical campaigns, high-voltage electrical engineering, cooling design, environmental impact assessment.</span></li>
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">And there is a third category that belongs to no engineer.</strong> The commercial negotiation of power and tariff is the developer’s. Any formal submission to the utility is signed by whoever holds title to the site. We prepare the technical case behind it; we do not sign it, and neither does anyone who tells you they can.</span></li>
      </ul>
    </article>
  </FullBleedSection>

  <FaqSection faqs={faqs} lang="en" bg="cream-deep" />

  <!-- CTA -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">Assessing a site in Paraguay?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Tell us what you are evaluating — site, power, water or permitting — and we will tell you what it actually takes here, and how long.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href={N.contact} variant="primary" size="lg">Start a conversation</Button>
        <Button href={N.solar} variant="ghost-dark" size="lg">Solar &amp; data centers</Button>
      </div>
    </div>
  </section>

  <style>
    /* Justify de prosa solo en el cuerpo del Insight, no en hero/CTA */
    article p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
  </style>

</Base>
