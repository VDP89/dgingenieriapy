---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SectorCard from '../components/SectorCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricBlock from '../components/MetricBlock.astro';
import FullBleedSection from '../components/FullBleedSection.astro';

const sectores = [
  {
    slug: 'vialidad', title: 'Diseño de Proyectos Viales',
    desc: 'Diseño, revisiones, auditorías y control técnico de caminos y rutas. Factibilidad y código SNIP.',
    gradientClass: 'from-sector-vial/90 to-sector-vial/40',
    img: '/img/sector-vial.jpg',
    tag: 'BID · MOPC'
  },
  {
    slug: 'pavimentos', title: 'Pavimentos',
    desc: 'Evaluación estructural, deflectometría y diseño de paquetes para todos los tipos de pavimento.',
    gradientClass: 'from-sector-pav/90 to-sector-pav/40',
    img: '/img/sector-pav.jpg',
    tag: 'Expertise'
  },
  {
    slug: 'aeropuertos', title: 'Aeropuertos, Hangares y Pistas',
    desc: 'Ingeniería de infraestructura aeronáutica: pistas, plataformas y hangares. Normativa OACI y DINAC.',
    gradientClass: 'from-sector-aero/90 to-sector-aero/40',
    img: '/img/sector-aero.jpg',
    tag: 'Proyectos'
  },
  {
    slug: 'puertos', title: 'Puertos y Fluvial',
    desc: 'Análisis de situaciones portuarias, estudios de ingeniería, coordinación de especialidades y soluciones de embarque.',
    gradientClass: 'from-sector-puertos/90 to-sector-puertos/40',
    img: '/img/sector-puertos.jpg',
    tag: 'Estudios'
  },
  {
    slug: 'fiscalizacion', title: 'Edificación Residencial',
    desc: 'Ala técnica del desarrollo residencial: anteproyecto, proyecto, gerenciamiento, construcción y fiscalización de edificaciones de mediano y gran porte.',
    gradientClass: 'from-sector-civil/90 to-sector-civil/40',
    img: '/img/sector-civil.jpg',
    tag: 'Ala técnica'
  },
  {
    slug: 'plantas-industriales', title: 'Plantas Industriales',
    desc: 'Diseño de plataformas, movimiento de suelos, accesos y fiscalización de obra industrial.',
    gradientClass: 'from-sector-plantas/90 to-sector-plantas/40',
    img: '/img/sector-plantas.jpg',
    tag: 'Industria'
  },
  {
    slug: 'urbanizaciones', title: 'Urbanizaciones',
    desc: 'Socio de ingeniería para desarrolladores: prefactibilidad de sitio, vialidad interna, redes, habilitación y fiscalización de obra.',
    gradientClass: 'from-sector-urb/90 to-sector-urb/40',
    img: '/img/sector-urb.jpg',
    tag: 'Desarrolladores'
  },
  {
    slug: 'solar', title: 'Energía Solar y Data Centers',
    desc: 'Socio local de ingeniería para parques solares y data centers: prefactibilidad de sitio, obras civiles, permisos ERNC y fiscalización.',
    gradientClass: 'from-sector-solar/90 to-sector-solar/40',
    img: '/img/sector-solar.jpg',
    tag: 'Socio local'
  },
];

const capacidades = [
  {
    title: 'Precisión desde el origen',
    desc: 'Relevamiento geoespacial de alta resolución que genera modelos digitales del terreno, ortomosaicos y nubes de puntos. La base técnica del proyecto se define con datos precisos desde el primer día.',
    icon: 'crosshair',
  },
  {
    title: 'Visibilidad total en obra',
    desc: 'Seguimiento de avance en tiempo real, alertas tempranas ante desviaciones y reportes ejecutivos diferenciados por stakeholder. El inversor tiene visibilidad completa del estado de su proyecto.',
    icon: 'monitor',
  },
  {
    title: 'Análisis con herramientas propias',
    desc: 'Desarrollamos soluciones de cálculo específicas para cada disciplina, calibradas con datos reales de proyectos ejecutados en Paraguay. Precisión local, no genérica.',
    icon: 'tool',
  },
];

const stats = [
  { value: '10+', label: 'Años de trayectoria' },
  { value: '8', label: 'Áreas de especialización' },
  { value: 'BID · MOPC · CAF', label: 'Organismos contratantes' },
];

const alianzas = ['BID', 'MOPC', 'CAF', 'Tecnoedil', 'COMYCSA', 'FLUODER', 'Jopla', 'A2', 'Incovial', 'Prointec', 'AII', 'EPC EAS', 'JBL SA', 'Noroda SA'];

const heroSlides = [
  {
    img: '/img/sector-vial.jpg',
    kicker: 'Diseño de proyectos viales',
    title: 'Datos precisos',
    accent: 'desde el primer día',
    subtitle: 'Relevamiento geoespacial, modelos digitales del terreno y estudios técnicos que sostienen cada etapa del proyecto.',
  },
  {
    img: '/img/sector-puertos.jpg',
    kicker: 'Puertos y fluvial',
    title: 'Coordinación técnica',
    accent: 'sobre el río Paraná',
    subtitle: 'Análisis de situaciones portuarias, estudios de ingeniería y soluciones para infraestructura de embarque.',
  },
  {
    img: '/img/sector-plantas.jpg',
    kicker: 'Plantas industriales',
    title: 'Ingeniería de sitio',
    accent: 'para operación real',
    subtitle: 'Diseño de plataformas, movimiento de suelos, accesos y fiscalización de obra industrial.',
  },
  {
    img: '/img/sector-urb.jpg',
    kicker: 'Urbanizaciones',
    title: 'Nivelación y servicios',
    accent: 'que habilitan el proyecto',
    subtitle: 'Diseño de plataformas, vialidad interna y servicios para el desarrollo de nuevas áreas urbanas.',
  },
  {
    img: '/img/destacado-bid.jpg',
    kicker: 'Proyecto destacado · MOPC',
    title: 'Factibilidad integral',
    accent: 'en 179 km de Chaco',
    subtitle: 'Diseño geométrico, estudio de tránsito, pavimentos y evaluación económica bajo metodología SNIP en la Ruta PY05.',
  },
];
---

<Base title="Inicio" preloadImg="/img/sector-vial.jpg">

  <!-- ============================================ -->
  <!-- HERO SLIDER — 4 slides, ken burns, crossfade -->
  <!-- Stays inline: JS+style coupled, 1-off usage. -->
  <!-- ============================================ -->
  <section data-hero class="hero-slider relative min-h-[85vh] flex items-center overflow-hidden bg-slate-dg">

    <!-- Slides -->
    <div class="absolute inset-0">
      {heroSlides.map((s, i) => (
        <div class={`hero-slide absolute inset-0 transition-opacity duration-[1200ms] ease-in-out ${i === 0 ? 'opacity-100 is-active' : 'opacity-0'}`} data-slide={i}>
          <div class="hero-slide-img absolute inset-0 bg-cover bg-center" style={`background-image: url(${s.img})`}></div>
          <div class="absolute inset-0 bg-gradient-to-br from-slate-dg/90 via-slate-dg/75 to-slate-dg/50"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-dg/60 via-transparent to-transparent"></div>
        </div>
      ))}
    </div>

    <!-- Decorative rings -->
    <div class="absolute top-[10%] right-[5%] w-[500px] h-[500px] border border-cream/[0.06] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-[15%] right-[15%] w-[300px] h-[300px] border border-arena/[0.08] rounded-full pointer-events-none"></div>

    <!-- Content — swaps per slide -->
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 py-20 w-full">
      <div class="max-w-[680px]">
        {heroSlides.map((s, i) => (
          <div class={`hero-text ${i === 0 ? 'block' : 'hidden'}`} data-text={i}>
            <div class="flex items-center gap-3 mb-8">
              <div class="h-px w-10 bg-arena"></div>
              <span class="text-[11px] font-semibold tracking-[3px] uppercase text-arena">{s.kicker}</span>
            </div>

            <h1 class="text-display text-cream text-4xl md:text-[56px] lg:text-[64px] mb-6 leading-[1.05]">
              {s.title}<br>
              <span class="text-arena">{s.accent}</span>
            </h1>

            <p class="text-[17px] leading-relaxed text-cream/70 mb-10 max-w-[520px]">
              {s.subtitle}
            </p>
          </div>
        ))}

        <!-- Fixed CTAs -->
        <div class="flex flex-wrap gap-4">
          <Button href="/contacto" variant="primary" magnetic>Realizar consulta</Button>
          <Button href="#sectores" variant="ghost-dark">Explorar sectores</Button>
        </div>
      </div>
    </div>

    <!-- Dots -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex items-center gap-3">
      {heroSlides.map((_, i) => (
        <button
          class={`hero-dot group relative h-[3px] transition-all duration-500 ease-out ${i === 0 ? 'w-12 bg-arena is-active' : 'w-6 bg-cream/30 hover:bg-cream/60'}`}
          data-dot={i}
          aria-label={`Ir a slide ${i + 1}`}
        ></button>
      ))}
    </div>

    <!-- Counter -->
    <div class="absolute bottom-8 right-5 md:right-8 lg:right-12 z-20 text-[11px] tracking-[2px] uppercase text-cream/40 font-medium flex items-center gap-3 hidden md:flex">
      <span data-slide-current>01</span>
      <span class="w-8 h-px bg-cream/15"></span>
      <span data-slide-total>0{heroSlides.length}</span>
    </div>
  </section>

  <script>
    // Hero slider — vanilla JS, 0 deps
    (() => {
      const slides = Array.from(document.querySelectorAll('[data-slide]'));
      const texts = Array.from(document.querySelectorAll('[data-text]'));
      const dots = Array.from(document.querySelectorAll('[data-dot]')) as HTMLButtonElement[];
      const counter = document.querySelector('[data-slide-current]');
      if (!slides.length) return;

      let current = 0;
      const total = slides.length;
      const DURATION = 6500;
      let timer: ReturnType<typeof setInterval>;

      const goTo = (idx: number) => {
        current = (idx + total) % total;
        slides.forEach((s, i) => {
          s.classList.toggle('opacity-100', i === current);
          s.classList.toggle('opacity-0', i !== current);
          s.classList.toggle('is-active', i === current);
        });
        texts.forEach((t, i) => {
          t.classList.toggle('block', i === current);
          t.classList.toggle('hidden', i !== current);
        });
        dots.forEach((d, i) => {
          const active = i === current;
          d.classList.toggle('w-12', active);
          d.classList.toggle('bg-arena', active);
          d.classList.toggle('is-active', active);
          d.classList.toggle('w-6', !active);
          d.classList.toggle('bg-cream/30', !active);
          d.classList.toggle('hover:bg-cream/60', !active);
        });
        if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      };

      const next = () => goTo(current + 1);
      const start = () => { timer = setInterval(next, DURATION); };
      const stop = () => { if (timer) clearInterval(timer); };

      dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); stop(); start(); }));

      const hero = document.querySelector('.hero-slider');
      if (hero) {
        hero.addEventListener('mouseenter', stop);
        hero.addEventListener('mouseleave', start);
      }

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReduced) start();
    })();

    // Magnetic buttons — cursor reactivity
    (() => {
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;
      const magnets = document.querySelectorAll<HTMLElement>('[data-magnetic]');
      magnets.forEach((el) => {
        el.style.transition = 'transform 250ms cubic-bezier(.2,.8,.2,1)';
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          el.style.transform = `translate(${x * 0.25}px, ${y * 0.3}px)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = 'translate(0,0)';
        });
      });
    })();
  </script>

  <style>
    /* Ken burns con zoom-in (0-84%) + zoom-out suave en el ultimo ~1s (84-100%).
       Duracion 6.5s = DURATION del JS para que la animacion termine EXACTO cuando
       el slide pierde is-active. Asi no hay snap: el ultimo frame ya es scale(1.02),
       igual al base rule. El zoom-out acompana visualmente al fade-out del slide. */
    @keyframes ken-burns {
      0%   { transform: scale(1.02); }
      84%  { transform: scale(1.12); }
      100% { transform: scale(1.02); }
    }
    .hero-slide-img {
      transform: scale(1.02);
    }
    .hero-slide.is-active .hero-slide-img {
      animation: ken-burns 6.5s ease-in-out forwards;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-slide.is-active .hero-slide-img { animation: none; }
    }
  </style>

  <!-- ============================================ -->
  <!-- STATS BAR                                    -->
  <!-- ============================================ -->
  <div class="bg-white border-b border-slate-dg/[0.08] py-8">
    <div class="max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 flex justify-center gap-10 md:gap-20 flex-wrap">
      {stats.map((s) => (
        <MetricBlock value={s.value} label={s.label} size="sm" />
      ))}
    </div>
  </div>

  <!-- ============================================ -->
  <!-- PROYECTO DESTACADO — Ruta PY05                -->
  <!-- ============================================ -->
  <FullBleedSection bg="cream" padding="md">
    <ProjectCard
      kicker="Proyecto destacado"
      title="Ruta PY05 — Factibilidad Técnica, Económica y Ambiental"
      description="Estudio de factibilidad para el mejoramiento de 179 km de ruta en el Chaco paraguayo, tramo Pozo Colorado – Fortín Gral. Díaz. Diseño geométrico, estudio de tránsito, diseño de pavimentos y evaluación económica bajo metodología SNIP."
      metrics={[
        { label: 'Cliente', value: 'MOPC' },
        { label: 'Longitud', value: '179 km' },
        { label: 'Alcance', value: 'Factibilidad integral' },
      ]}
      img="/img/destacado-bid.jpg"
      imgAlt="Ruta PY05 — Chaco paraguayo"
      href="/sectores/vialidad"
      ctaLabel="Ver sector vialidad"
      variant="dark"
      imageSide="right"
      layout="equal"
    />
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- SECTORES                                     -->
  <!-- ============================================ -->
  <FullBleedSection bg="white" padding="md" id="sectores">
    <SectionHeader
      kicker="Áreas de expertise"
      title="Sectores"
      lead="Experiencia documentada en cada sector, con capacidad de respuesta integral."
      align="split"
      class="mb-12"
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {sectores.map((s) => (
        <SectorCard
          slug={s.slug}
          title={s.title}
          desc={s.desc}
          img={s.img}
          gradientClass={s.gradientClass}
          tag={s.tag}
        />
      ))}
    </div>
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- CAPACIDADES                                  -->
  <!-- ============================================ -->
  <FullBleedSection bg="cream-deep" padding="md">
    <SectionHeader
      kicker="Capacidades"
      title="Lo que nos diferencia"
      lead="Integramos tecnología propia y datos de alta resolución para que cada decisión de proyecto tenga respaldo técnico real."
      align="center"
      class="mb-14"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {capacidades.map((c) => (
        <div class="bg-white rounded-xl p-8 border border-slate-dg/[0.08] shadow-sm hover:shadow-md transition-shadow" data-animate>
          <div class="w-12 h-12 rounded-lg bg-arena/10 flex items-center justify-center mb-5">
            {c.icon === 'crosshair' && (
              <svg class="w-6 h-6 text-arena" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="3" /><path d="M12 2v4m0 12v4M2 12h4m12 0h4" />
              </svg>
            )}
            {c.icon === 'monitor' && (
              <svg class="w-6 h-6 text-arena" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8m-4-4v4" /><path d="M6 10h4m2 0h6M6 13h3" />
              </svg>
            )}
            {c.icon === 'tool' && (
              <svg class="w-6 h-6 text-arena" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
              </svg>
            )}
          </div>
          <h3 class="text-lg font-extrabold tracking-tight mb-3">{c.title}</h3>
          <p class="text-[14px] text-slate-dg/70 leading-relaxed">{c.desc}</p>
        </div>
      ))}
    </div>
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- SEGUNDO PROYECTO — Puerto Torocuá             -->
  <!-- ============================================ -->
  <FullBleedSection bg="white" padding="md">
    <ProjectCard
      kicker="Infraestructura portuaria"
      title="Puerto Torocuá — Estudios de Ingeniería"
      description="Análisis de situaciones portuarias sobre el río Paraná. Estudios de ingeniería, interconexión de especialidades y soluciones técnicas para infraestructura de embarque."
      metrics={[
        { label: 'Ubicación', value: 'Río Paraná' },
        { label: 'Alcance', value: 'Estudios' },
      ]}
      img="/img/proyecto-puertos.jpg"
      imgAlt="Estudios Puerto Torocuá"
      href="/sectores/puertos"
      ctaLabel="Ver sector puertos"
      variant="light"
      imageSide="left"
      layout="wide-image"
    />
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- FIRMA / NOSOTROS                             -->
  <!-- ============================================ -->
  <FullBleedSection bg="cream" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div data-animate>
        <span class="text-[11px] font-bold tracking-[3px] uppercase text-arena mb-3 block">Sobre DG</span>
        <h2 class="text-3xl font-extrabold tracking-tight leading-tight mb-5">10 años dando claridad técnica a proyectos complejos</h2>
        <p class="text-[15px] text-slate-dg/75 leading-relaxed mb-6">
          DG Ingeniería integra análisis, datos y coordinación técnica para dar claridad a cada etapa de un proyecto de infraestructura. Operamos con un equipo base de especialistas y una red de profesionales que se integra según la necesidad de cada proyecto.
        </p>
        <ul class="space-y-0 mb-8">
          {[
            'Contratista directo de organismos multilaterales (BID, CAF)',
            'Red de profesionales según la escala del proyecto',
            'Metodología propia: datos, criterio y control en cada etapa',
            'Proyectos ejecutados en múltiples regiones y contextos',
          ].map((item) => (
            <li class="flex items-start gap-3 py-3 text-[14px] text-slate-dg/75 border-b border-slate-dg/[0.06]">
              <div class="w-5 h-5 rounded-full bg-arena/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-arena" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="4 9 8 13 14 5"/>
                </svg>
              </div>
              {item}
            </li>
          ))}
        </ul>
        <Button href="/nosotros" variant="secondary">
          Sobre nosotros <span class="group-hover:translate-x-1 transition-transform inline-block ml-2">&rarr;</span>
        </Button>
      </div>

      <!-- Quote card -->
      <div class="bg-white rounded-xl p-8 md:p-10 border border-slate-dg/[0.08] shadow-sm" data-animate>
        <div class="w-10 h-10 rounded-full bg-arena/10 flex items-center justify-center mb-5">
          <svg class="w-5 h-5 text-arena" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
        </div>
        <p class="text-lg font-medium leading-relaxed text-slate-dg italic mb-6">
          "Cada decisión de proyecto merece claridad técnica. Eso es lo que entregamos."
        </p>
        <div class="h-px bg-slate-dg/[0.08] mb-5"></div>
        <div class="flex items-center gap-4 flex-wrap">
          {['Datos', 'Criterio', 'Decisiones', 'Diseño', 'Control'].map((step, i) => (
            <Fragment>
              <span class="text-[12px] font-semibold text-gray-neutral px-3 py-1.5 bg-cream rounded-md border border-slate-dg/[0.08]">{step}</span>
              {i < 4 && <span class="text-arena/40 text-xs">&rarr;</span>}
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- ALIANZAS                                     -->
  <!-- ============================================ -->
  <FullBleedSection bg="white" padding="sm" border="both">
    <div class="text-center mb-8">
      <span class="text-[10px] font-bold tracking-[3px] uppercase text-gray-neutral/50">Alianzas y clientes</span>
    </div>
    <div class="flex justify-center items-center gap-8 md:gap-14 flex-wrap max-w-[900px] mx-auto">
      {alianzas.map((a) => (
        <div class="text-[13px] font-bold text-slate-dg/20 tracking-[2.5px] uppercase py-2 hover:text-slate-dg/60 transition-colors cursor-default">{a}</div>
      ))}
    </div>
  </FullBleedSection>

  <!-- ============================================ -->
  <!-- CTA FINAL                                    -->
  <!-- ============================================ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-[10%] left-[10%] w-[400px] h-[400px] border border-cream/[0.03] rounded-full"></div>

    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">¿Necesita claridad en su próximo proyecto?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[480px] mx-auto">Desde la factibilidad hasta el control final. Hablemos sobre cómo dar certeza a cada decisión.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="mailto:info@dgingenieriasrl.com" variant="ghost-dark" size="lg">info@dgingenieriasrl.com</Button>
      </div>
    </div>
  </section>

</Base>
