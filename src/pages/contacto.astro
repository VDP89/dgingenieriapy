---
import Base from '../layouts/Base.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];

// Endpoint del formulario (Web3Forms). El sitio es estatico (Astro + Vercel sin
// adaptador SSR), por lo que el envio se delega a un servicio de forms.
// La access key es PUBLICA por diseno (se usa en client-side); el form entrega
// a info@dgingenieriasrl.com (cuenta Web3Forms de DG). Si se vacia, cae al mailto.
const WEB3FORMS_KEY = 'db199a81-4dd1-495e-93fa-9128890dc745';
const formAction = 'https://api.web3forms.com/submit';
const formConfigured = WEB3FORMS_KEY !== '' && !WEB3FORMS_KEY.startsWith('TU_');
---

<Base
  title="Contacto"
  description="Contacto DG Ingeniería SRL. Consultas técnicas, fiscalización y desarrollo de proyectos de infraestructura. Asunción, Paraguay."
  breadcrumbs={breadcrumbs}
>

  <!-- HERO -->
  <section class="bg-slate-dg text-cream py-16 md:py-28">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-4">Contacto</h1>
      <p class="text-lg text-cream/65 max-w-2xl leading-relaxed">Escribinos para consultas técnicas, proyectos o propuestas de colaboración.</p>
    </div>
  </section>

  <!-- CONTENIDO PRINCIPAL -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- FORMULARIO -->
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-8">Déjanos un mensaje</h2>
          <form
            id="contacto-form"
            class="space-y-6"
            name="contacto"
            method="POST"
            action={formAction}
            data-configured={String(formConfigured)}
          >
            <!-- Access key pública de Web3Forms (entrega a info@dgingenieriasrl.com) -->
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <!-- Asunto del email que recibe DG -->
            <input type="hidden" name="subject" value="Nuevo mensaje desde dgingenieriapy.com/contacto" />
            <input type="hidden" name="from_name" value="Web dgingenieriapy.com" />

            <!-- Honeypot anti-spam de Web3Forms (oculto a humanos). -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <!-- Nombre -->
            <div>
              <label for="nombre" class="block text-sm font-semibold text-slate-dg mb-2">
                Nombre <span class="text-arena" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                aria-required="true"
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full px-4 py-3 rounded border border-slate-dg/20 focus:border-arena focus:outline-none focus-visible:ring-2 focus-visible:ring-arena/30 transition-colors"
              />
            </div>

            <!-- Empresa -->
            <div>
              <label for="empresa" class="block text-sm font-semibold text-slate-dg mb-2">Empresa</label>
              <input
                type="text"
                id="empresa"
                name="empresa"
                autocomplete="organization"
                placeholder="Nombre de tu empresa"
                class="w-full px-4 py-3 rounded border border-slate-dg/20 focus:border-arena focus:outline-none focus-visible:ring-2 focus-visible:ring-arena/30 transition-colors"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-dg mb-2">
                Email <span class="text-arena" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                aria-required="true"
                autocomplete="email"
                placeholder="tu@email.com"
                class="w-full px-4 py-3 rounded border border-slate-dg/20 focus:border-arena focus:outline-none focus-visible:ring-2 focus-visible:ring-arena/30 transition-colors"
              />
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block text-sm font-semibold text-slate-dg mb-2">
                Mensaje <span class="text-arena" aria-hidden="true">*</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                required
                aria-required="true"
                placeholder="Cuéntanos sobre tu proyecto o consulta"
                rows="6"
                class="w-full px-4 py-3 rounded border border-slate-dg/20 focus:border-arena focus:outline-none focus-visible:ring-2 focus-visible:ring-arena/30 transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Botón -->
            <button
              type="submit"
              class="w-full bg-slate-dg text-cream px-6 py-3 rounded font-semibold text-sm hover:bg-slate-light transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-arena focus-visible:ring-offset-2 focus-visible:ring-offset-cream disabled:opacity-60 disabled:cursor-not-allowed"
            >
              Enviar mensaje
            </button>

            <!-- Mensaje de estado (éxito / error). Se actualiza vía JS. -->
            <p
              id="form-status"
              role="status"
              aria-live="polite"
              class="text-sm text-slate-dg/80 hidden"
            ></p>

            {!formConfigured && (
              <p class="text-xs text-gray-neutral">
                También podés escribirnos directo a
                <a href="mailto:info@dgingenieriasrl.com" class="text-arena hover:text-arena-light underline">info@dgingenieriasrl.com</a>.
              </p>
            )}
          </form>

          <script>
            // Envío del formulario de contacto vía Web3Forms (AJAX, sin recargar).
            // Si el endpoint todavía no está configurado (data-configured="false"),
            // se hace fallback a un mailto: pre-rellenado para no perder el contacto.
            const form = document.getElementById('contacto-form') as HTMLFormElement | null;
            const status = document.getElementById('form-status');

            function showStatus(msg: string, ok: boolean) {
              if (!status) return;
              status.textContent = msg;
              status.classList.remove('hidden');
              status.classList.toggle('text-arena', !ok);
              status.classList.toggle('text-slate-dg/80', ok);
            }

            if (form) {
              const configured = form.dataset.configured === 'true';

              form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const data = new FormData(form);

                // Fallback sin backend: abrir el cliente de correo con el mensaje cargado.
                if (!configured) {
                  const nombre = String(data.get('nombre') || '');
                  const empresa = String(data.get('empresa') || '');
                  const email = String(data.get('email') || '');
                  const mensaje = String(data.get('mensaje') || '');
                  const cuerpo =
                    `Nombre: ${nombre}\n` +
                    (empresa ? `Empresa: ${empresa}\n` : '') +
                    `Email: ${email}\n\n${mensaje}`;
                  const href =
                    'mailto:info@dgingenieriasrl.com' +
                    '?subject=' + encodeURIComponent('Consulta desde dgingenieriapy.com') +
                    '&body=' + encodeURIComponent(cuerpo);
                  window.location.href = href;
                  showStatus('Abrimos tu cliente de correo para enviar el mensaje a info@dgingenieriasrl.com.', true);
                  return;
                }

                const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
                if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }

                try {
                  const res = await fetch(form.action, {
                    method: 'POST',
                    body: data,
                    headers: { Accept: 'application/json' },
                  });
                  if (res.ok) {
                    form.reset();
                    showStatus('Mensaje enviado. Te respondemos dentro de 48 horas hábiles.', true);
                  } else {
                    showStatus('No pudimos enviar el mensaje. Escribinos a info@dgingenieriasrl.com.', false);
                  }
                } catch {
                  showStatus('No pudimos enviar el mensaje. Escribinos a info@dgingenieriasrl.com.', false);
                } finally {
                  if (btn) { btn.disabled = false; btn.textContent = 'Enviar mensaje'; }
                }
              });
            }
          </script>
        </div>

        <!-- INFORMACIÓN DE CONTACTO -->
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-8">Información de contacto</h2>

          <!-- Email -->
          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Email</h3>
            <a
              href="mailto:info@dgingenieriasrl.com"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              info@dgingenieriasrl.com
            </a>
            <p class="text-sm text-gray-neutral mt-2">Respuesta en horario laboral</p>
          </div>

          <!-- Teléfono -->
          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Teléfono</h3>
            <a
              href="tel:+595976335132"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              +595 976 335 132
            </a>
            <p class="text-sm text-gray-neutral mt-2">Lunes a viernes, 8:30 AM a 18:00 PM (PYT)</p>
          </div>

          <!-- Ubicación -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Ubicación</h3>
            <p class="text-lg font-medium text-slate-dg mb-1">Asunción</p>
            <p class="text-sm text-gray-neutral">Paraguay</p>
          </div>

          <!-- Información adicional -->
          <div class="mt-12 p-6 rounded-lg bg-cream-deep border border-slate-dg/10">
            <h3 class="font-semibold text-slate-dg mb-3">¿En qué podemos ayudarte?</h3>
            <ul class="space-y-2 text-sm text-slate-dg/80">
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Consulta técnica en infraestructura</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Desarrollo de proyectos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Fiscalización de obras</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Propuestas de colaboración</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FOOTER -->
  <section class="bg-slate-dg text-cream text-center py-16 md:py-20">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">¿Tienes urgencia?</h2>
      <p class="text-base text-cream/50 mb-8 max-w-[440px] mx-auto">Llámanos directamente al número de teléfono indicado arriba.</p>
    </div>
  </section>

</Base>
