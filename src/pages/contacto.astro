---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];

---

<Base
  title="Contacto"
  description="Contacto DG Ingeniería SRL. Consultas técnicas, fiscalización y desarrollo de proyectos de infraestructura. Asunción, Paraguay."
  breadcrumbs={breadcrumbs}
>

  <!-- HERO -->
  <section class="bg-slate-dg text-cream py-16 md:py-28">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-4">Contacto</h1>
      <p class="text-lg text-cream/65 max-w-2xl leading-relaxed">Escribinos para consultas técnicas, proyectos o propuestas de colaboración.</p>
    </div>
  </section>

  <!-- CONTENIDO PRINCIPAL -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- FORMULARIO -->
        <div>
          <ContactForm lang="es" />
        </div>

        <!-- INFORMACIÓN DE CONTACTO -->
        <div>
          <h2 class="text-2xl font-bold tracking-tight mb-8">Información de contacto</h2>

          <!-- Email -->
          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Email</h3>
            <a
              href="mailto:info@dgingenieriasrl.com"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              info@dgingenieriasrl.com
            </a>
            <p class="text-sm text-gray-neutral mt-2">Respuesta en horario laboral</p>
          </div>

          <!-- Teléfono -->
          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Teléfono</h3>
            <a
              href="tel:+595976335132"
              class="text-lg text-slate-dg hover:text-arena transition-colors font-medium"
            >
              +595 976 335 132
            </a>
            <p class="text-sm text-gray-neutral mt-2">Lunes a viernes, 8:30 AM a 18:00 PM (PYT)</p>
          </div>

          <!-- WhatsApp -->
          <div class="mb-10 pb-10 border-b border-slate-dg/10">
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">WhatsApp</h3>
            <a
              href="https://wa.me/595976335132"
              target="_blank"
              rel="noopener"
              aria-label="Escribir a DG Ingeniería por WhatsApp"
              class="inline-flex items-center gap-2 text-lg text-slate-dg hover:text-slate-light transition-colors font-medium"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
            <p class="text-sm text-gray-neutral mt-2">Mismo número del teléfono: +595 976 335 132</p>
          </div>

          <!-- Ubicación -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[2px] text-gray-neutral mb-3">Ubicación</h3>
            <p class="text-lg font-medium text-slate-dg mb-1">Asunción</p>
            <p class="text-sm text-gray-neutral">Paraguay</p>
          </div>

          <!-- Información adicional -->
          <div class="mt-12 p-6 rounded-lg bg-cream-deep border border-slate-dg/10">
            <h3 class="font-semibold text-slate-dg mb-3">¿En qué podemos ayudarte?</h3>
            <ul class="space-y-2 text-sm text-slate-dg/80">
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Consulta técnica en infraestructura</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Desarrollo de proyectos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Fiscalización de obras</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-arena mt-1">▪</span>
                <span>Propuestas de colaboración</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FOOTER -->
  <section class="bg-slate-dg text-cream text-center py-16 md:py-20">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">¿Tienes urgencia?</h2>
      <p class="text-base text-cream/50 mb-8 max-w-[440px] mx-auto">Llámanos directamente al número de teléfono indicado arriba.</p>
    </div>
  </section>

</Base>
