---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const pubDate = '23 de julio de 2026';
const readTime = '5 min de lectura';

const titulo = 'Preparación de licitaciones: revisar el pliego completo, no una muestra';
const desc = 'Una exigencia escondida en la sección de informaciones adicionales representaba el 16% del monto de la oferta. Apareció porque el pliego se leyó entero. Cómo lo hacemos y qué recibe el cliente.';

// JSON-LD: Article — pieza editorial citable + entity SEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: desc,
  image: 'https://dgingenieriapy.com/img/insight-ia-produccion.jpg',
  author: { '@id': 'https://victordelpuerto.com/#person' },
  datePublished: '2026-07-23',
  dateModified: '2026-07-23',
  publisher: {
    '@type': 'Organization',
    name: 'DG Ingeniería SRL',
    logo: {
      '@type': 'ImageObject',
      url: 'https://dgingenieriapy.com/img/dg-isotipo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://dgingenieriapy.com/blog/ia-en-produccion-experiencia-ingenieria/',
  },
  inLanguage: 'es-PY',
  articleSection: 'Preparación de licitaciones',
  keywords: 'preparación de licitaciones, pliego de bases y condiciones, documentación técnica, licitación pública internacional, implementación de IA, inteligencia artificial en empresas, ingeniería de proyecto, Paraguay',
};

// JSON-LD: FAQ — citation surface para LLMs y rich results Google
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde suelen esconderse las exigencias que definen una licitación?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Fuera de los términos de referencia y del cuadro de precios. En un caso real, el pliego exigía proveer una camioneta cero kilómetro con seguro y combustible por doce meses, dos estaciones de trabajo y equipos topográficos, y la exigencia estaba en la sección de informaciones adicionales. Costear ese renglón representó el 16% del monto de la oferta. Una propuesta presentada sin esa partida compite con un número al que le falta la sexta parte.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Por qué es difícil revisar un pliego de licitación completo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Porque exige leer el pliego y sus adendas, cruzar cada requisito de calificación contra los antecedentes de la empresa, armar los formularios técnicos y financieros en el formato oficial, costear con la estructura de personal exigida, y sostener la coherencia entre piezas que se cuentan por decenas y se tocan entre sí. Contra ese volumen el calendario empuja a priorizar y muestrear, y lo que queda sin leer es lo que nadie sabe que se perdió.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cómo se usa IA en la preparación de licitaciones sin perder criterio técnico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Cada disciplina tiene su base de conocimiento escrita: la normativa que aplica, los umbrales que se adoptan y las reglas que salieron de errores previos. Sobre esa base opera un especialista asistido por IA que cubre una porción acotada del trabajo. Unos fijan el criterio técnico, otros lo materializan en el documento o en el modelo de cálculo, un tercer grupo solo audita, y la decisión de entrar a una licitación, con qué precio y qué se firma, es siempre de una persona.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué recibe el cliente al final del trabajo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Documentación completa, con los formularios armados sobre el archivo oficial del pliego. Y planillas trazables y modificables: el costeo vive en un modelo de cálculo único, con hojas espejo de cada formulario oficial tirando del mismo motor y controles cruzados que se verifican solos. Al mover una tarifa, un plazo o una dedicación, el modelo recalcula la cadena entera y muestra dónde impactó.',
      },
    },
  ],
};

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Insights', url: '/blog' },
  { name: 'Preparación de licitaciones', url: '/blog/ia-en-produccion-experiencia-ingenieria' },
];
---

<Base
  title={titulo}
  description={desc}
  ogImage="/img/insight-ia-produccion.jpg"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageHero
    img="/img/insight-ia-produccion.jpg"
    imgAlt="Camino sobre terraplén en el bajo Chaco paraguayo, con palmares a ambos lados"
    kicker="Insights · Preparación de licitaciones"
    title="Revisar el pliego completo,"
    titleAccent="no una muestra"
    subtitle="Una exigencia escondida en la sección de informaciones adicionales valía el 16% de la oferta."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Realizar consulta</Button>
    <Button href="/blog" variant="ghost-dark">Ver más Insights</Button>
  </PageHero>

  <!-- Meta info -->
  <section class="border-b border-slate-dg/10 bg-cream">
    <div class="max-w-[820px] mx-auto px-5 md:px-8 py-5 flex items-center gap-5 text-[12.5px] text-slate-dg/55 tracking-wide">
      <span class="font-semibold uppercase tracking-[2px] text-arena/85 text-[11px]">Insight #2</span>
      <span aria-hidden="true">·</span>
      <span>{pubDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </section>

  <!-- HOOK: el caso primero -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <p class="text-[19px] text-slate-dg leading-[1.7] font-medium">
        El pliego de una licitación internacional exigía proveer una camioneta cero kilómetro con seguro y combustible por doce meses, dos estaciones de trabajo y equipos topográficos. La exigencia estaba en la sección de informaciones adicionales. Fuera de los términos de referencia, fuera del cuadro de precios: en una sección que casi nadie cruza con el presupuesto.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        Costear ese renglón representó el 16% del monto de la oferta.
      </p>

      <p>
        Una propuesta que llega a la mesa de evaluación sin esa partida compite con un número al que le falta la sexta parte. Y el pliego estaba en regla: la exigencia estaba escrita, con todas las letras, en el lugar donde nadie la busca.
      </p>

      <p>
        Apareció porque el pliego se leyó entero.
      </p>
    </article>
  </FullBleedSection>

  <!-- El problema -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El problema"
        title="Por qué eso"
        titleAccent="es difícil"
      />

      <p>
        Preparar la documentación de una licitación pública internacional es de los trabajos más caros que enfrenta una consultora, y el costo es de personal y de calendario.
      </p>

      <p>
        Hay que leer el pliego completo y sus adendas, que suelen modificar reglas de fondo. Cruzar cada requisito de calificación contra los antecedentes de la empresa. Armar los formularios técnicos y financieros en el formato oficial. Costear el servicio con la estructura de personal que el pliego exige. Y sostener la coherencia entre piezas que se cuentan por decenas y se tocan entre sí: mover una tarifa cambia el precio, la dedicación por profesional y tres formularios.
      </p>

      <p>
        Contra ese volumen, el calendario de presentación empuja siempre en la misma dirección. Se prioriza. Se muestrea. Y lo que queda sin leer es, por definición, lo que nadie sabe que se perdió.
      </p>
    </article>
  </FullBleedSection>

  <!-- La solución: la metodología es el héroe -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El método"
        title="Cómo"
        titleAccent="lo resolvemos"
      />

      <p>
        DG hace ingeniería de proyecto: diseño vial, hidrología, geotecnia, pavimentos, documentación para contrataciones públicas. Lo que cambió en el último año es que ese criterio dejó de trabajar de a una pieza por vez.
      </p>

      <p>
        Cada disciplina tiene hoy su base de conocimiento escrita: la normativa que aplica, los umbrales que se adoptan, los errores que ya cometimos y las reglas que salieron de ellos. Sobre esa base opera un especialista asistido por IA, y la arquitectura tiene una decisión de fondo.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        Cada especialista cubre una porción acotada del trabajo, y solo esa.
      </p>

      <p>
        Unos fijan el criterio técnico: qué período de retorno se adopta, qué factor de seguridad exige el talud. Otros lo materializan en el documento o en el modelo de cálculo. Un tercer grupo solo audita, y no produce nada. La decisión de entrar a una licitación, con qué precio y qué se firma, es siempre de una persona.
      </p>

      <p>
        Esa separación es la que permite barrer el pliego entero en vez de muestrearlo, sin que el criterio de ingeniería se diluya al cubrir más superficie. La herramienta acelera la lectura. Lo que decide qué mirar, y qué significa lo que aparece, es el criterio.
      </p>
    </article>
  </FullBleedSection>

  <!-- El caso -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El caso"
        title="Lo que aparece"
        titleAccent="cuando se lee todo"
      />

      <p>
        En esa misma licitación, además del renglón de la sección de informaciones adicionales:
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Las adendas habían dado vuelta la estrategia de precio</h3>
      <p>
        Dos adendas cambiaron la base de cálculo de todos los umbrales de calificación: pasaron de porcentaje sobre el monto ofertado a porcentaje sobre el monto estimado del llamado. Eso desacopla el precio de la calificación, y ofertar bajo deja de aflojar los requisitos de capacidad. Quien costeó sobre el pliego original costeó sobre reglas vencidas.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">El emplazamiento tenía un problema que el pliego no mencionaba</h3>
      <p>
        El sitio estaba en el bajo Chaco, con un dique costero de por medio. Los suelos dispersivos fallan por tubificación, y los ensayos mecánicos convencionales no los detectan: hace falta un paquete específico. Los términos de referencia no lo pedían. El barrido de riesgos del sitio sí.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">El pliego se contradecía a sí mismo en siete puntos</h3>
      <p>
        Presentados como consultas formales ante el convocante. Una frase truncada dejaba en cero puntos a seis especialistas del plantel propuesto.
      </p>

      <p>
        Ninguno de los cuatro hallazgos salió de leer más rápido. Salieron de leer todo.
      </p>
    </article>
  </FullBleedSection>

  <!-- La ventaja -->
  <FullBleedSection bg="cream-deep" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="La ventaja"
        title="Qué recibe"
        titleAccent="el cliente"
      />

      <p>
        Sobre nuestra propia experiencia, el análisis y el armado documental pasaron a ocupar una fracción de las horas de equipo que llevaban antes. La lectura completa del pliego dejó de competir contra la fecha de presentación.
      </p>

      <p>
        Y quedan dos cosas que se llevan puestas después de la entrega.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Documentación completa</h3>
      <p>
        Los formularios se arman sobre el archivo oficial del pliego, con el barrido de exigencias hecho sobre el documento entero.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Planillas trazables y modificables</h3>
      <p>
        El costeo vive en un modelo de cálculo único, con las hojas espejo de cada formulario oficial tirando del mismo motor y controles cruzados que se verifican solos. Cuando hay que mover una tarifa, un plazo o una dedicación, el modelo recalcula la cadena entera y muestra dónde impactó. El entregable sigue siendo un instrumento de trabajo después de presentado.
      </p>
    </article>
  </FullBleedSection>

  <!-- El contexto (la investigación, ahora como respaldo) -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El contexto"
        title="Lo que separa"
        titleAccent="a los que lo logran"
      />

      <figure class="my-8">
        <img
          src="/img/insight-particion-bcg.svg"
          alt="Barra apilada con la partición de madurez en IA según BCG: 5% obtiene valor sustancial, 35% escala y ya genera valor, 60% con retorno todavía marginal."
          class="w-full rounded-lg border border-slate-dg/10"
          loading="lazy"
          width="800"
          height="348"
        />
        <figcaption class="mt-3 text-[13px] text-slate-dg/55 leading-relaxed">
          La partición completa del estudio de BCG. El tramo del medio es el que suele quedar fuera del gráfico.
        </figcaption>
      </figure>

      <p>
        El estudio <em>Build for the Future</em> de BCG, sobre 1.250 ejecutivos, encontró que solo el 5% de las empresas obtiene valor sustancial de la inteligencia artificial. El dato que suele quedar fuera del gráfico es el tramo del medio: un <strong class="text-slate-dg">35% que ya está escalando y empieza a generarlo</strong>.
      </p>

      <p>
        Un working paper de Humlum y Vestergaard, publicado por el NBER sobre 25.000 trabajadores, explica por qué el resto se queda afuera. En las mismas ocupaciones, los ensayos controlados documentan mejoras superiores al 15%, mientras la adopción espontánea rinde 2,8%. El modelo es el mismo de los dos lados. Lo que cambia es que alguien haya diseñado cómo se usa.
      </p>

      <p>
        Ese diseño es trabajo de ingeniería, y es la parte que se saltea con más frecuencia.
      </p>
    </article>
  </FullBleedSection>

  <!-- Conclusión -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="Conclusión"
        title="El criterio"
        titleAccent="es el activo"
      />

      <p>
        Incorporar la herramienta lleva una tarde. Escribir el criterio que la herramienta necesita para servir de algo lleva meses, y es lo que no se compra hecho.
      </p>

      <p>
        <strong class="text-slate-dg">Resultado:</strong> ofertas que entran completas, secciones técnicas revisadas con una segunda mirada antes de salir, problemas de emplazamiento detectados cuando todavía son baratos, y un modelo de cálculo que el cliente sigue usando.
      </p>
    </article>
  </FullBleedSection>

  <style>
    /* Justify de prosa solo en el cuerpo del Insight, no en hero/CTA */
    article p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
  </style>

  <!-- CTA final -->
  <section class="relative py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[40px] mb-4">¿Tiene un pliego por delante?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[520px] mx-auto">Hablemos sobre la preparación de su documentación técnica.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/blog" variant="ghost-dark" size="lg">Ver más Insights</Button>
      </div>
    </div>
  </section>

</Base>
