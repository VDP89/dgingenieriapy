---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const pubDate = '23 de julio de 2026';
const readTime = '4 min de lectura';

const desc = 'Preparar la documentación de una licitación internacional consume equipo y calendario. Cómo lo resolvemos con especialistas asistidos por IA, y qué gana el cliente: documentación completa y planillas trazables.';

// JSON-LD: Article — pieza editorial citable + entity SEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Implementación de IA en producción: nuestra experiencia como empresa de ingeniería',
  description: desc,
  image: 'https://dgingenieriapy.com/img/insight-ia-produccion.jpg',
  author: { '@id': 'https://victordelpuerto.com/#person' },
  datePublished: '2026-07-23',
  dateModified: '2026-07-23',
  publisher: {
    '@type': 'Organization',
    name: 'DG Ingeniería SRL',
    logo: {
      '@type': 'ImageObject',
      url: 'https://dgingenieriapy.com/img/dg-isotipo.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://dgingenieriapy.com/blog/ia-en-produccion-experiencia-ingenieria/',
  },
  inLanguage: 'es-PY',
  articleSection: 'Implementación de IA',
  keywords: 'implementación de IA, inteligencia artificial en empresas, IA en producción, preparación de licitaciones, documentación técnica, pliego de bases y condiciones, ingeniería de proyecto, Paraguay',
};

// JSON-LD: FAQ — citation surface para LLMs y rich results Google
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Por qué la mayoría de las empresas obtiene poco valor de la inteligencia artificial?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Los estudios muestran una brecha entre condiciones diseñadas y uso libre: los ensayos controlados documentan mejoras superiores al 15% en las mismas ocupaciones donde la adopción espontánea rinde 2,8%. La diferencia aparece con el mismo modelo de los dos lados, así que lo que cambia es el diseño de cómo se usa. Según BCG, además del 5% que obtiene valor sustancial hay un 35% que ya escala y empieza a generarlo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Por qué es tan costoso preparar la documentación de una licitación internacional?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Porque exige leer el pliego completo y sus adendas, cruzar cada requisito de calificación contra los antecedentes de la empresa, armar los formularios técnicos y financieros en el formato oficial, costear con la estructura de personal exigida, y sostener la coherencia entre decenas de piezas que se tocan entre sí. El riesgo mayor es que una exigencia que define la calificación esté escrita en una sección que nadie asocia con ella.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cómo se implementa IA en una empresa de ingeniería sin perder control técnico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Separando los papeles. Unos especialistas fijan el criterio técnico (período de retorno, factor de seguridad), otros lo materializan en el documento o en el modelo de cálculo, un tercer grupo solo audita, y la decisión de entrar a una licitación, con qué precio y qué se firma, es siempre de una persona. Esa separación permite barrer el pliego completo en vez de muestrearlo, sosteniendo el criterio de ingeniería.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué recibe el cliente además del ahorro de tiempo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Documentación completa, con los formularios armados sobre el archivo oficial del pliego y el barrido de exigencias hecho sobre el documento entero. Y planillas trazables y modificables: el costeo vive en un modelo de cálculo único, con hojas espejo de cada formulario oficial tirando del mismo motor y controles cruzados que se verifican solos. Al mover una tarifa, un plazo o una dedicación, el modelo recalcula la cadena entera y muestra dónde impactó.',
      },
    },
  ],
};

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Insights', url: '/blog' },
  { name: 'Implementación de IA en producción', url: '/blog/ia-en-produccion-experiencia-ingenieria' },
];
---

<Base
  title="Implementación de IA en producción: nuestra experiencia como empresa de ingeniería"
  description={desc}
  ogImage="/img/insight-ia-produccion.jpg"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <PageHero
    img="/img/insight-ia-produccion.jpg"
    imgAlt="Camino sobre terraplén en el bajo Chaco paraguayo, con palmares a ambos lados"
    kicker="Insights · Implementación de IA"
    title="Implementación de IA"
    titleAccent="en producción real"
    subtitle="Qué cambia en la preparación de una licitación, y qué recibe el cliente al final."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Realizar consulta</Button>
    <Button href="/blog" variant="ghost-dark">Ver más Insights</Button>
  </PageHero>

  <!-- Meta info -->
  <section class="border-b border-slate-dg/10 bg-cream">
    <div class="max-w-[820px] mx-auto px-5 md:px-8 py-5 flex items-center gap-5 text-[12.5px] text-slate-dg/55 tracking-wide">
      <span class="font-semibold uppercase tracking-[2px] text-arena/85 text-[11px]">Insight #2</span>
      <span aria-hidden="true">·</span>
      <span>{pubDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </section>

  <!-- Apertura -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <p class="text-[19px] text-slate-dg leading-[1.7] font-medium">
        En una clase de posgrado circularon este año dos gráficos. El primero, del estudio <em>Build for the Future</em> de BCG: el 5% de las empresas obtiene valor sustancial de la inteligencia artificial y el 60% apenas registra retorno. El segundo, de un working paper de Humlum y Vestergaard publicado por el NBER: el ahorro de tiempo entre trabajadores que ya adoptaron IA generativa fue de 2,8%.
      </p>

      <p>
        Son datos sólidos: el del NBER cubre 25.000 trabajadores en 7.000 lugares de trabajo. Los dos gráficos dejan afuera el dato que más nos sirvió.
      </p>
    </article>
  </FullBleedSection>

  <!-- El dato -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El dato"
        title="El tramo que falta"
        titleAccent="en el gráfico"
      />

      <figure class="my-8">
        <img
          src="/img/insight-particion-bcg.svg"
          alt="Barra apilada con la partición de madurez en IA según BCG: 5% obtiene valor sustancial, 35% escala y ya genera valor, 60% con retorno todavía marginal."
          class="w-full rounded-lg border border-slate-dg/10"
          loading="lazy"
          width="800"
          height="348"
        />
        <figcaption class="mt-3 text-[13px] text-slate-dg/55 leading-relaxed">
          La partición completa del estudio de BCG. El tramo del medio es el que suele quedar fuera del gráfico.
        </figcaption>
      </figure>

      <p>
        La partición de BCG tiene tres tramos. Entre el 5% que ya obtiene valor sustancial y el 60% rezagado hay un <strong class="text-slate-dg">35% que está escalando y empieza a generarlo</strong>. Ese tercio del medio es el tramo alcanzable para una empresa que decide ponerse a trabajar en serio.
      </p>

      <p>
        El dato del NBER tiene una vuelta parecida. En esas mismas once ocupaciones, los ensayos controlados documentan mejoras superiores al 15%. En el campo, con adopción espontánea, dan 2,8%. La brecha aparece con el mismo modelo de los dos lados. Lo que cambia entre un caso y el otro es el diseño de cómo se usa.
      </p>
    </article>
  </FullBleedSection>

  <!-- El problema -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El problema"
        title="Lo que cuesta"
        titleAccent="preparar una licitación"
      />

      <p>
        Preparar la documentación de una licitación pública internacional es de los trabajos más caros que enfrenta una consultora, y el costo es de personal y de calendario.
      </p>

      <p>
        Hay que leer el pliego completo y sus adendas, que suelen modificar reglas de fondo. Cruzar cada requisito de calificación contra los antecedentes de la empresa. Armar los formularios técnicos y financieros en el formato oficial. Costear el servicio con la estructura de personal que el pliego exige. Y sostener la coherencia entre todas esas piezas, que se cuentan por decenas y se tocan entre sí: cambiar una tarifa mueve el precio, la dedicación por profesional y tres formularios.
      </p>

      <p>
        El riesgo mayor está en otro lado. Una exigencia que define la calificación puede estar escrita en una sección que nadie asocia con ella. Cuando eso pasa, la oferta se presenta incompleta y compite con un número que le falta cubrir.
      </p>
    </article>
  </FullBleedSection>

  <!-- Cómo lo resolvemos -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="La solución"
        title="Cómo"
        titleAccent="lo resolvemos"
      />

      <p>
        DG hace ingeniería de proyecto: diseño vial, hidrología, geotecnia, pavimentos, documentación para contrataciones públicas. Sobre ese trabajo montamos una capa de especialistas asistidos por IA, cada uno con su base de conocimiento propia, construida a partir de normativa, manuales y los criterios que ya usábamos.
      </p>

      <p>
        La decisión de fondo es que <strong class="text-slate-dg">cada especialista cubre una porción acotada del trabajo, y solo esa.</strong> Unos fijan el criterio técnico: qué período de retorno se adopta, qué factor de seguridad exige el talud. Otros lo materializan en el documento o en el modelo de cálculo. Un tercer grupo solo audita. Y la decisión de entrar a una licitación, con qué precio y qué se firma, es siempre de una persona.
      </p>

      <p>
        Esa separación es la que permite barrer el pliego completo en vez de muestrearlo, y sostener el criterio de ingeniería mientras se cubre más superficie.
      </p>
    </article>
  </FullBleedSection>

  <!-- El caso -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="El caso"
        title="Lo que cambia"
        titleAccent="en un trabajo real"
      />

      <p>
        En la preparación de la documentación técnica para una licitación pública internacional, con evaluación 90% técnica y 10% económica, el barrido completo devolvió esto:
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Equipamiento exigido fuera del lugar donde se lo busca</h3>
      <p>
        El pliego pedía proveer una camioneta cero kilómetro con seguro y combustible por doce meses, dos estaciones de trabajo y equipos topográficos. Estaba en la sección de informaciones adicionales, lejos de los términos de referencia y del cuadro de precios. Costearlo representó cerca del <strong class="text-slate-dg">16% del monto de la oferta</strong>.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Un cambio de regla en las adendas que dio vuelta la estrategia de precio</h3>
      <p>
        Dos adendas modificaron la base de cálculo de todos los umbrales de calificación, que pasaron de porcentaje sobre el monto ofertado a porcentaje sobre el monto estimado del llamado. Eso desacopla el precio de la calificación: ofertar bajo dejó de aflojar los requisitos de capacidad. La oferta se presentó al 100% del referencial, cuando con la regla anterior el mismo análisis habría recomendado una rebaja.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Suelos dispersivos en el emplazamiento</h3>
      <p>
        El sitio estaba en el bajo Chaco, con un dique costero de por medio. Los suelos dispersivos fallan por tubificación y exigen un paquete de ensayos específico. Los términos de referencia no los mencionaban.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Siete inconsistencias del propio pliego</h3>
      <p>
        Presentadas como consultas formales ante el convocante. Una frase truncada dejaba en cero puntos a seis especialistas del plantel propuesto.
      </p>
    </article>
  </FullBleedSection>

  <!-- La ventaja -->
  <FullBleedSection bg="cream-deep" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="La ventaja"
        title="Qué recibe"
        titleAccent="el cliente"
      />

      <p>
        Sobre nuestra propia experiencia en este tipo de trabajo, el análisis y el armado documental se reducen a una fracción del tiempo que llevaban antes, del orden del 20% de las horas de equipo. La lectura completa del pliego y sus adendas deja de competir contra el calendario de presentación.
      </p>

      <p>
        Lo que se gana además del tiempo son dos cosas concretas.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Documentación completa</h3>
      <p>
        Los formularios se arman sobre el archivo oficial del pliego, con el barrido de exigencias hecho sobre el documento entero, no sobre el resumen.
      </p>

      <h3 class="text-[20px] font-extrabold tracking-tight text-slate-dg pt-4">Planillas trazables y modificables</h3>
      <p>
        El costeo vive en un modelo de cálculo único, con las hojas espejo de cada formulario oficial tirando del mismo motor y controles cruzados que se verifican solos. Cuando el cliente necesita mover una tarifa, un plazo o una dedicación, el modelo recalcula la cadena entera y muestra dónde impactó. El entregable es un instrumento de trabajo que sigue sirviendo después de la presentación.
      </p>
    </article>
  </FullBleedSection>

  <!-- Conclusión -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">

      <SectionHeader
        kicker="Conclusión"
        title="El criterio"
        titleAccent="es el activo"
      />

      <p>
        La distancia entre el 15% que muestran los ensayos y el 2,8% del campo se explica por el diseño. Incorporar la herramienta lleva una tarde. Lo que toma trabajo es escribir el criterio de ingeniería que la herramienta necesita para servir de algo, y ese criterio es el activo que queda.
      </p>

      <p>
        <strong class="text-slate-dg">Resultado:</strong> ofertas que entran completas, secciones técnicas revisadas con una segunda mirada antes de salir, problemas de emplazamiento detectados cuando todavía son baratos, y un modelo de cálculo que el cliente puede seguir usando.
      </p>
    </article>
  </FullBleedSection>

  <style>
    /* Justify de prosa solo en el cuerpo del Insight, no en hero/CTA */
    article p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
  </style>

  <!-- CTA final -->
  <section class="relative py-20 md:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[40px] mb-4">¿Tiene un pliego por delante?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[520px] mx-auto">Hablemos sobre la preparación de su documentación técnica.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/blog" variant="ghost-dark" size="lg">Ver más Insights</Button>
      </div>
    </div>
  </section>

</Base>
