---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FullBleedSection from '../../components/FullBleedSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';
import FaqSection from '../../components/FaqSection.astro';

const pubDate = '19 de agosto de 2026';
const readTime = '6 min de lectura';

const titulo = 'Lo que la tarifa eléctrica no le dice a un inversor extranjero';
const desc = 'Paraguay tiene energía hidroeléctrica abundante y barata. Eso es cierto. Tres cosas que esa historia deja afuera son las que deciden si un proyecto intensivo en energía se construye, y cuándo.';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: desc,
  image: 'https://dgingenieriapy.com/img/insight-energia-paraguay.jpg',
  author: { '@id': 'https://victordelpuerto.com/#person' },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://dgingenieriapy.com/#organization',
    name: 'DG Ingeniería SRL',
    logo: {
      '@type': 'ImageObject',
      url: 'https://dgingenieriapy.com/img/dg-isotipo.png',
    },
  },
  datePublished: '2026-08-19',
  dateModified: '2026-08-19',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://dgingenieriapy.com/blog/energia-paraguay-lo-que-la-tarifa-no-dice/',
  },
  inLanguage: 'es-PY',
  articleSection: 'Energía y decisiones de sitio',
  keywords: 'invertir en Paraguay, tarifa eléctrica Paraguay, data center Paraguay, potencia firme, time-to-power, selección de sitio, energía hidroeléctrica Paraguay, inversión extranjera Paraguay, prefactibilidad de sitio',
};

const faqs = [
  {
    q: '¿La energía eléctrica es realmente barata en Paraguay?',
    a: 'Sí, y el excedente es real: el país produce mucha más electricidad de la que consume. Dos precisiones importan para un modelo de inversión. La tarifa está denominada en guaraníes, así que el costo medido en dólares se mueve con el tipo de cambio aunque el pliego tarifario quede intacto. Y para el gran consumo intensivo la cifra aplicable no es pública: se establece mediante un contrato especial con la prestadora. Un valor en dólares por megavatio-hora citado de un informe es una foto del tipo de cambio en una fecha, no una propiedad fija del país.',
  },
  {
    q: '¿Qué decide si un predio en Paraguay sirve para un proyecto intensivo en energía?',
    a: 'Tres filtros, y ninguno es el tamaño del predio. La potencia firme que efectivamente puede asignarse a un privado en ese nodo, y el tiempo que toma disponerla. El agua y la refrigeración, o lo que cuesta diseñar sin ellas. Y la fibra redundante por rutas físicamente diversas. Después la inundabilidad y la capacidad portante recortan la superficie útil. Los tres se pueden evaluar de escritorio, antes de comprometer una campaña de campo y antes de firmar una opción de compra.',
  },
  {
    q: '¿Cuánto tarda conseguir energía para un proyecto grande en Paraguay?',
    a: 'Existe un procedimiento administrativo publicado para conectar una gran carga, con pasos y plazos de respuesta definidos, y contiene relojes de caducidad que dan de baja el expediente si no se le da curso. Pero ese procedimiento publicado tiene una banda superior, y por encima de ella no hay un calendario equivalente publicado. Para un proyecto de decenas o centenas de megavatios no hay plazo que consultar: el cronograma se construye desde el caso concreto, el punto de conexión y las obras involucradas.',
  },
  {
    q: '¿Por qué importa tanto la fecha al leer sobre regulación energética paraguaya?',
    a: 'Porque el marco que gobierna la inversión intensiva en energía estuvo en revisión activa durante 2026, con regímenes introducidos y derogados dentro del mismo año. Un análisis publicado no se actualiza solo cuando cambia una norma, así que material escrito hace dieciocho meses puede describir con precisión algo que ya no rige. Toda afirmación sobre tarifa, régimen o incentivo debería llevar la fecha en que fue verificada, incluido este artículo, que refleja la situación al 19 de agosto de 2026.',
  },
];

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Insights', url: '/blog' },
  { name: 'Lo que la tarifa eléctrica no le dice a un inversor extranjero', url: '/blog/energia-paraguay-lo-que-la-tarifa-no-dice' },
];
---

<Base
  title={titulo}
  description={desc}
  ogImage="/img/insight-energia-paraguay.jpg"
  preloadImg="/img/insight-energia-paraguay.webp"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <PageHero
    img="/img/insight-energia-paraguay.jpg"
    imgAlt="Curva de carga escalonada que sube dentro de un procedimiento publicado y continúa punteada por encima de su banda superior"
    kicker="Insights · Energía y decisiones de sitio"
    title="Lo que la tarifa eléctrica"
    titleAccent="no le dice a un inversor extranjero"
    subtitle="La energía barata es real. Tres cosas que esa historia deja afuera son las que deciden si el proyecto se construye, y cuándo."
    height="md"
  >
    <Button href="/contacto" variant="primary" magnetic>Realizar consulta</Button>
    <Button href="/blog" variant="ghost-dark">Ver más Insights</Button>
  </PageHero>

  <!-- Meta info -->
  <section class="border-b border-slate-dg/10 bg-cream">
    <div class="max-w-[820px] mx-auto px-5 md:px-8 py-5 flex items-center gap-5 text-[12.5px] text-slate-dg/55 tracking-wide">
      <span class="font-semibold uppercase tracking-[2px] text-arena/85 text-[11px]">Insight #3</span>
      <span aria-hidden="true">·</span>
      <span>{pubDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </section>

  <!-- HOOK -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <p class="text-[19px] text-slate-dg leading-[1.7] font-medium">
        Casi toda conversación sobre invertir en Paraguay empieza igual: energía hidroeléctrica abundante, de las tarifas industriales más bajas de la región, un país que exporta mucha más electricidad de la que consume.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        Todo eso es correcto. Y también es donde la mayoría de los análisis se detiene.
      </p>

      <p>
        Las tres cosas que vienen después son las que deciden si un proyecto intensivo en capital se construye, y con qué calendario. Escribimos esto desde el lado del comitente, y nada de lo que sigue es una razón para no invertir acá. Es lo que querríamos saber antes de firmar algo.
      </p>
    </article>
  </FullBleedSection>

  <!-- 1 -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Uno"
        title="La tarifa se cotiza en guaraníes."
        titleAccent="Su modelo, no."
      />

      <p>
        La tarifa eléctrica paraguaya se publica en guaraníes por kilovatio-hora. Su comité de inversión piensa en dólares. Esos dos hechos no son un detalle.
      </p>

      <p>
        El pliego tarifario puede quedar completamente intacto durante dos años mientras el costo de esa misma energía, medido en dólares, se mueve de forma relevante —en cualquier dirección— solamente porque se movió el guaraní. No hay anuncio cuando eso pasa, porque no se anunció nada. Nadie cambió la tarifa.
      </p>

      <p>
        La consecuencia práctica es que un valor en dólares por megavatio-hora citado de un informe es una foto del tipo de cambio en una fecha determinada, no una propiedad fija del país. Si está modelando un contrato de suministro a veinte años, la moneda de denominación pertenece a su análisis de sensibilidad, al lado de la tarifa misma.
      </p>

      <p class="text-[14.5px] text-slate-dg/55 border-l-2 border-arena/30 pl-4">
        Al 19 de agosto de 2026 la referencia era de 6.020 guaraníes por dólar. Verifique la serie del Banco Central para la fecha que use su modelo.
      </p>
    </article>
  </FullBleedSection>

  <!-- 2 -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Dos"
        title="El cuello no es la generación."
        titleAccent="Es la transmisión."
      />

      <p>
        El excedente es real: Paraguay consume una fracción de lo que produce y exporta el resto. De ahí, una persona razonable concluye que hay energía disponible.
      </p>

      <p>
        Generar y entregar son preguntas distintas. La capacidad que le importa a un proyecto es la que puede llegar a <em>su</em> predio, a <em>su</em> nivel de tensión, con la redundancia que su operación exige. Eso es una cuestión de transmisión y de subestación, y es donde el sistema está ajustado: lo suficiente como para que el país haya tenido eventos de suministro pese al excedente.
      </p>

      <p>
        Entonces el número que gobierna un cronograma no es la capacidad instalada de una subestación cercana. Es la potencia firme que efectivamente puede asignarse a un privado en ese nodo, y el tiempo que toma disponerla. A esa segunda cifra la llamamos <strong class="text-slate-dg">time-to-power</strong>, y es la que mueve una fecha de inversión.
      </p>
    </article>
  </FullBleedSection>

  <!-- 3 -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Tres"
        title="Para una gran carga, la tarifa no es un número."
        titleAccent="Es un contrato."
      />

      <p>
        Por debajo de cierto tamaño, usted consulta su tarifa. Por encima, la negocia.
      </p>

      <p>
        El régimen paraguayo de gran consumo intensivo —la categoría en la que cae un data center, una planta industrial grande o una carga similar— funciona por contrato especial con la prestadora. El pliego publicado crea la categoría y después remite al contrato. Lo que significa que la respuesta a «cuánto me va a costar la energía» no es algo que se consulte. Es algo que se establece, con condiciones, plazos y una vigencia atada.
      </p>

      <p>
        Esto no es una buena ni una mala noticia. Es una pregunta de otra naturaleza que la que trae la mayoría de los inversores, y cambia quién tiene que estar en la mesa, y cuándo.
      </p>
    </article>
  </FullBleedSection>

  <!-- El techo -->
  <FullBleedSection bg="cream-deep" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="El reloj que nadie menciona"
        title="El procedimiento publicado"
        titleAccent="tiene un techo"
      />

      <p>
        Existe un procedimiento administrativo publicado para conectar una gran carga, con pasos y plazos de respuesta definidos. Lo leímos, y hay dos cosas que conviene saber antes de planificar sobre él.
      </p>

      <p>
        La primera es que contiene relojes de caducidad. Un expediente al que no se le da curso dentro de una ventana definida se da de baja, y el proceso vuelve a empezar. Eso hace que la <em>secuencia</em> de sus decisiones importe tanto como las decisiones: presentar temprano, solo para tener el dato, puede significar presentar dos veces.
      </p>

      <p>
        La segunda es más consecuente. El procedimiento publicado tiene una banda superior. Por encima, el procedimiento tal como está escrito no aplica, y ningún calendario equivalente ocupa su lugar. Para un proyecto de decenas o centenas de megavatios, no hay un plazo que se pueda consultar.
      </p>

      <p class="text-[19px] text-slate-dg leading-[1.7] font-semibold">
        Para una gran carga en Paraguay, el time-to-power no se consulta. Se construye.
      </p>
    </article>
  </FullBleedSection>

  <!-- Vigencia -->
  <FullBleedSection bg="white" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Sobre las fechas"
        title="El marco se está moviendo,"
        titleAccent="y eso importa más que de costumbre"
      />

      <p>
        Durante 2026 el marco que gobierna la inversión intensiva en energía en Paraguay estuvo en revisión activa. Se introdujeron y se derogaron regímenes dentro del mismo año.
      </p>

      <p>
        La consecuencia para un inversor extranjero es concreta y poco glamorosa: <strong class="text-slate-dg">toda afirmación sobre tarifa, régimen o incentivo tiene que llevar la fecha en que fue cierta.</strong> Un análisis bien escrito publicado hace dieciocho meses puede describir algo que ya no existe, y no va a avisar que venció.
      </p>

      <p>
        Eso aplica a lo que está leyendo ahora, y por eso lleva fecha.
      </p>
    </article>
  </FullBleedSection>

  <!-- Secuencia -->
  <FullBleedSection bg="cream" padding="md">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Qué cambia esto"
        title="Evalúe el predio"
        titleAccent="antes de comprarlo"
      />

      <p>
        La mayoría de las decisiones de sitio llegan en el mismo orden: primero se consigue la tierra, después se revisa la energía. En Paraguay, para un uso intensivo en energía, ese orden sale caro.
      </p>

      <p>
        Los tres filtros que deciden un predio —potencia firme, agua y refrigeración, fibra redundante— se pueden evaluar de escritorio, antes de comprometer una campaña de campo y antes de firmar una opción de compra. Después la inundabilidad y la capacidad portante recortan todavía más la superficie útil.
      </p>

      <p>
        Evaluar primero no es prudencia. Es el paso más barato de toda la secuencia, y el único que puede devolver un «no» mientras un «no» todavía sale gratis.
      </p>
    </article>
  </FullBleedSection>

  <!-- Frontera -->
  <FullBleedSection bg="white" padding="md" border="top">
    <article class="max-w-[760px] mx-auto text-[16.5px] text-slate-dg/82 leading-[1.78] space-y-6">
      <SectionHeader
        kicker="Alcance"
        title="Dónde termina nuestro trabajo"
        titleAccent="— y de quién es después"
      />

      <p>
        Nos parece que el límite vale decirlo con todas las letras, porque es lo que hace creíble todo lo anterior.
      </p>

      <ul class="space-y-3 list-none pl-0">
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Resolvemos</strong> el sitio y la ingeniería: relevamiento y modelo del terreno, hidrología e inundabilidad, movimiento de suelos y plataformas, accesos de transporte pesado, área neta aprovechable, y el caso técnico y su hoja de ruta ante las instituciones.</span></li>
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Coordinamos</strong> lo que deben firmar especialistas: campañas geotécnicas, ingeniería eléctrica de alta tensión, diseño de refrigeración, evaluación de impacto ambiental.</span></li>
        <li class="flex gap-3"><span class="text-arena font-bold">&rarr;</span><span><strong class="text-slate-dg">Y hay una tercera categoría que no es de ningún ingeniero.</strong> La negociación comercial de potencia y tarifa es del desarrollador. Toda presentación formal ante la prestadora la firma quien tiene el título del predio. Nosotros preparamos el caso técnico que la sostiene; no la firmamos, y tampoco la firma quien le diga que puede hacerlo.</span></li>
      </ul>
    </article>
  </FullBleedSection>

  <FaqSection faqs={faqs} lang="es" bg="cream-deep" />

  <!-- CTA -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-slate-dg"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="relative z-10 max-w-[1200px] mx-auto px-5 md:px-8 lg:px-12 text-center">
      <h2 class="text-display text-cream text-3xl md:text-[44px] mb-4">¿Está evaluando un predio en Paraguay?</h2>
      <p class="text-cream/45 text-base md:text-lg mb-10 max-w-[560px] mx-auto">Cuéntenos qué está evaluando —sitio, potencia, agua o permisos— y le decimos qué exige de verdad acá, y cuánto tarda.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/contacto" variant="primary" size="lg">Realizar consulta</Button>
        <Button href="/sectores/solar" variant="ghost-dark" size="lg">Solar y data centers</Button>
      </div>
    </div>
  </section>

  <style>
    /* Justify de prosa solo en el cuerpo del Insight, no en hero/CTA */
    article p {
      text-align: justify;
      text-justify: inter-word;
      hyphens: auto;
    }
  </style>

</Base>
