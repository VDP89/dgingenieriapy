---
import Base from '../layouts/Base.astro';

const upcoming = [
  {
    tag: 'Infraestructura',
    title: 'Factibilidad: donde se decide el éxito de un proyecto',
    desc: 'Por qué los estudios previos definen más que la ejecución misma.',
  },
  {
    tag: 'Tecnología',
    title: 'Datos de campo vs. supuestos de oficina',
    desc: 'Cómo el relevamiento de precisión cambia las decisiones de ingeniería.',
  },
  {
    tag: 'Gerencia',
    title: 'Lo que el inversor necesita ver en obra',
    desc: 'Información diferenciada para cada actor del proyecto.',
  },
];
---

<Base title="Insights">

  <!-- HERO -->
  <section class="bg-slate-dg text-cream py-16 md:py-28">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight mb-4">Insights</h1>
      <p class="text-lg text-cream/65 max-w-2xl leading-relaxed">Perspectivas técnicas desde la práctica. Análisis, criterio y lecciones de proyectos reales.</p>
    </div>
  </section>

  <!-- PRÓXIMAMENTE -->
  <section class="py-16 md:py-24">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <div class="flex items-center gap-3 mb-10">
        <div class="h-px w-8 bg-arena"></div>
        <span class="text-[11px] font-bold tracking-[3px] uppercase text-arena">Próximamente</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {upcoming.map((item) => (
          <div class="group rounded-xl border border-slate-dg/10 bg-white p-8 hover:border-arena/30 hover:shadow-sm transition-all">
            <span class="text-[10px] font-bold tracking-[2px] uppercase text-arena/60 mb-3 block">{item.tag}</span>
            <h3 class="text-lg font-bold tracking-tight text-slate-dg mb-3 leading-snug">{item.title}</h3>
            <p class="text-[14px] text-slate-dg/60 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 max-w-[520px]">
        <p class="text-[15px] text-slate-dg/60 leading-relaxed">
          Estamos preparando contenido basado en nuestra experiencia en proyectos de infraestructura en Paraguay. Cada artículo parte de un caso real, no de teoría.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-dg text-cream text-center py-16 md:py-20">
    <div class="max-w-[1140px] mx-auto px-4 md:px-8 lg:px-20">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">¿Tiene una consulta técnica?</h2>
      <p class="text-base text-cream/50 mb-8 max-w-[440px] mx-auto">Hablemos directamente sobre su proyecto.</p>
      <a href="/contacto" class="bg-arena text-white px-6 py-3 rounded font-semibold text-sm hover:bg-arena-light transition-colors inline-block">Realizar consulta</a>
    </div>
  </section>

</Base>
