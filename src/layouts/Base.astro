---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Imagen LCP a precargar (ej. hero principal de la pagina). */
  preloadImg?: string;
  /** Breadcrumb para JSON-LD en paginas internas. */
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = 'DG Ingeniería SRL — Claridad técnica para proyectos de infraestructura en Paraguay.',
  ogImage = '/img/og-dg-default.jpg',
  preloadImg,
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dgingenieriapy.com');
const isHome = Astro.url.pathname === '/';

// JSON-LD: Organization + LocalBusiness siempre. Breadcrumb solo si se provee.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DG Ingeniería SRL',
  url: 'https://dgingenieriapy.com',
  logo: 'https://dgingenieriapy.com/img/dg-isotipo.png',
  email: 'info@dgingenieriasrl.com',
  telephone: '+595976335132',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Asunción',
    addressCountry: 'PY',
  },
  sameAs: [
    'https://www.linkedin.com/company/dg-ingenieria-srl',
    'https://www.instagram.com/dgingenieria_py/',
    'https://www.facebook.com/dgingenieriaSRL',
  ],
};

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'DG Ingeniería SRL',
  image: 'https://dgingenieriapy.com/img/og-dg-default.jpg',
  description,
  url: 'https://dgingenieriapy.com',
  email: 'info@dgingenieriasrl.com',
  telephone: '+595976335132',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Asunción',
    addressCountry: 'PY',
  },
  areaServed: { '@type': 'Country', name: 'Paraguay' },
  knowsAbout: [
    'Diseño de proyectos viales',
    'Pavimentos',
    'Aeropuertos y pistas',
    'Puertos y fluvial',
    'Gerencia y fiscalización',
    'Plantas industriales',
    'Urbanizaciones',
    'Energía solar y data centers',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:30',
    closes: '18:00',
  },
};

const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.url, 'https://dgingenieriapy.com').toString(),
      })),
    }
  : null;

// JSON-LD: Person para Víctor Del Puerto (founder/CEO). Cross-link entity SEO
// entre DG corporate y track personal (blog, paper Lucy, GitHub).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://victordelpuerto.com/#person',
  name: 'Víctor Del Puerto',
  givenName: 'Víctor',
  familyName: 'Del Puerto',
  jobTitle: 'Gerente General',
  worksFor: {
    '@type': 'Organization',
    name: 'DG Ingeniería SRL',
    url: 'https://dgingenieriapy.com',
  },
  url: 'https://victordelpuerto.com',
  sameAs: [
    'https://www.linkedin.com/in/victordelpuertog/',
    'https://victordelpuerto.com',
    'https://github.com/VDP89',
    'https://orcid.org/0009-0001-3573-1490',
    'https://doi.org/10.5281/zenodo.19555971',
    'https://x.com/vdelpuerto',
  ],
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- OG Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={`${title} — DG Ingeniería`}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:site_name" content="DG Ingeniería SRL">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={`${title} — DG Ingeniería`}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Google Analytics 4 — Measurement ID G-BWHXWJDQ25 (Property: dgingenieriapy.com) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-BWHXWJDQ25"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-BWHXWJDQ25', {
      anonymize_ip: true,
      send_page_view: true,
    });

    // Eventos custom — funnel DG
    document.addEventListener('click', (e) => {
      const target = e.target.closest('a, button');
      if (!target) return;
      const href = target.getAttribute('href') || '';
      if (href.startsWith('mailto:')) {
        gtag('event', 'email_click', { email: href.replace('mailto:', '') });
      } else if (href.startsWith('tel:')) {
        gtag('event', 'tel_click', { tel: href.replace('tel:', '') });
      } else if (href === '/contacto' || href.endsWith('/contacto') || href.endsWith('/contacto/')) {
        gtag('event', 'contact_click', { source: window.location.pathname });
      } else if (href.startsWith('/sectores/')) {
        gtag('event', 'service_view', { sector: href.split('/sectores/')[1].replace(/\/$/, '') });
      } else if (href.startsWith('/blog/') && href !== '/blog/' && href !== '/blog') {
        gtag('event', 'insight_open', { slug: href.split('/blog/')[1].replace(/\/$/, '') });
      }
    });

    // insight_read: 75% scroll en post de blog
    if (window.location.pathname.startsWith('/blog/') && window.location.pathname !== '/blog/' && window.location.pathname !== '/blog') {
      let fired = false;
      window.addEventListener('scroll', () => {
        if (fired) return;
        const scrolled = (window.scrollY + window.innerHeight) / document.documentElement.scrollHeight;
        if (scrolled >= 0.75) {
          fired = true;
          gtag('event', 'insight_read', { slug: window.location.pathname });
        }
      }, { passive: true });
    }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- LCP preload — la pagina puede pasar la imagen del hero principal.
       Si es .webp se agrega type="image/webp" para que browsers sin soporte
       no preloadeen el recurso (evita doble descarga cuando el hero es <picture>). -->
  {preloadImg && (
    <link
      rel="preload"
      as="image"
      href={preloadImg}
      fetchpriority="high"
      type={preloadImg.endsWith('.webp') ? 'image/webp' : undefined}
    />
  )}

  <!-- Favicon — DG isotipo sobre fondo crema -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <title>{title} — DG Ingeniería</title>

  <!-- JSON-LD: Organization + ProfessionalService + Person (siempre); BreadcrumbList si la pagina lo provee. -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <!-- Slot para schemas adicionales por pagina (Article, FAQ, HowTo, etc) -->
  <slot name="head" />

  <!-- Smooth page transitions -->
  <ClientRouter />
</head>
<body class="bg-cream text-slate-dg">

