{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/relevamiento-con-drones",
      "destination": "/sectores/relevamiento-aereo",
      "permanent": true
    },
    {
      "source": "/insights",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/insights/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.dgingenieriapy.com"
        }
      ],
      "destination": "https://dgingenieriapy.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.dgingenieriapy.com"
        }
      ],
      "destination": "https://dgingenieriapy.com/:path*",
      "permanent": true
    }
  ]
}
